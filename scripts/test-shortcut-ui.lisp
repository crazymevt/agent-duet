;;;; Included by test-conversation-ui-body.lisp after test-layout-ui.lisp.
(in-package #:agent-duet)

(defun shortcut-test-descendants (widget)
  (cons widget
        (loop for child = (gtk:widget-get-first-child widget)
                then (gtk:widget-get-next-sibling child)
              while child append (shortcut-test-descendants child))))

(let* ((*settings* nil) (*controls* nil)
       (*window* (make-instance 'gtk:window))
       (header (make-header))
       (dialog (show-shortcut-settings))
       (widgets (shortcut-test-descendants dialog))
       (entries (remove-if-not (lambda (w) (typep w 'gtk:entry)) widgets)))
  (declare (ignore header))
  (labels ((click (label)
             (gobject:emit
              (find-if (lambda (w) (and (typep w 'gtk:button)
                                       (equal label (gtk:button-get-label w)))) widgets)
              :clicked)))
    (assert (= 3 (length entries)))
    ;; A duplicate must leave all saved bindings unchanged.
    (gtk:editable-set-text (first entries) "Alt+F1")
    (gtk:editable-set-text (second entries) "Option+F1")
    (click "Apply")
    (assert (null *settings*))
    (assert (gtk:widget-has-css-class (find-if (lambda (w) (and (typep w 'gtk:label)
                                                                (search "different" (gtk:label-get-text w))))
                                               widgets)
                                      "error"))
    (click "Restore defaults")
    ;; The reminder to apply is not an error.
    (assert (not (gtk:widget-has-css-class (find-if (lambda (w) (and (typep w 'gtk:label)
                                                                     (search "Press Apply" (gtk:label-get-text w))))
                                                    widgets)
                                           "error")))
    (assert (equal (default-panel-shortcut :agents-shortcut)
                   (gtk:editable-get-text (first entries))))
    (assert (null *settings*))
    (gtk:editable-set-text (first entries) "Alt+F1")
    (gtk:editable-set-text (second entries) "")
    (gtk:editable-set-text (third entries) "Super+F3")
    (click "Apply")
    (assert (equal "Alt+F1" (setting :agents-shortcut)))
    (assert (equal "" (setting :checklist-shortcut)))
    (assert (search "Alt+F1" (gtk:widget-get-tooltip-text (control :agent-toggle))))
    (assert (search "Disabled" (gtk:widget-get-tooltip-text (control :checklist-toggle))))
    (load-settings)
    (assert (equal "Super+F3" (panel-shortcut-text :terminal-shortcut))))
  (let* ((dialog (show-shortcut-settings))
         (widgets (shortcut-test-descendants dialog))
         (entry (find-if (lambda (w) (typep w 'gtk:entry)) widgets))
         (cancel (find-if (lambda (w) (and (typep w 'gtk:button)
                                         (equal "Cancel" (gtk:button-get-label w)))) widgets)))
    (gtk:editable-set-text entry "Alt+F2")
    (gobject:emit cancel :clicked)
    (assert (equal "Alt+F1" (setting :agents-shortcut))))
  (gtk:window-destroy *window*))
;; The sidebar shortcut shares the existing checklist visibility control.
(let ((*settings* nil) (*controls* nil))
  (make-header)
  ;; Both icons are drawn locally, so missing system icon themes cannot break them.
  (dolist (key '(:agent-toggle :sidebar-toggle))
    (assert (typep (gtk:button-get-child (control key)) 'gtk:drawing-area)))
  (assert (search "Toggle agents" (gtk:widget-get-tooltip-text (control :agent-toggle))))
  (assert (not (gtk:toggle-button-get-active (control :sidebar-toggle))))
  (gtk:toggle-button-set-active (control :sidebar-toggle) t)
  (assert (setting :checklist-visible))
  (assert (gtk:check-button-get-active (control :checklist-toggle)))
  (gtk:check-button-set-active (control :checklist-toggle) nil)
  (assert (not (setting :checklist-visible)))
  (assert (not (gtk:toggle-button-get-active (control :sidebar-toggle)))))
(format t "~&Shortcut settings UI checks passed.~%")
;; Drive the real window controller over the real layout. GDK can't build
;; key events, so the signal is emitted without one and the handler compares
;; the keyval and modifiers itself; the window shortcuts are in the capture
;; phase, so focus in a pane or the Terminal doesn't change what they see.
(let* ((*settings* (list :equal-agent-panels-version 2 :last-agent-view :agents-left
                         :agents-shortcut "Alt+F5" :checklist-shortcut "Super+F6"
                         :terminal-shortcut "Ctrl+Shift+F7"))
       (*controls* nil) (*panes* nil) (*workflow* nil) (*history* nil)
       (*directory* nil) (*view-only* nil) (*closing* nil)
       (*checklist* nil) (*checklist-boxes* nil)
       (*terminals* nil) (*current-terminal* nil) (*terminal-panel* nil)
       (*terminal-stack* nil) (*terminal-tabs* nil)
       (*claude* (make-instance 'claude-agent :id :claude :name "Claude"))
       (*codex* (make-instance 'codex-agent :id :codex :name "ChatGPT"))
       (*view* :agents-left)
       (*window* (make-instance 'gtk:window :default-width 1200 :default-height 800))
       (original (symbol-function 'new-terminal)))
  (unwind-protect
       (progn
         ;; Showing the panel must not start a real shell here.
         (setf (symbol-function 'new-terminal) (lambda (&key focus) (declare (ignore focus))))
         (gtk:window-set-titlebar *window* (make-header))
         (gtk:window-set-child *window* (make-main-content))
         (let ((keys (setup-window-keys *window*)))
           (assert (eq :capture (gtk:event-controller-get-propagation-phase keys)))
           (gtk:window-present *window*)
           (settle-layout-test-window)
           (labels ((press (name modifiers)
                      (gobject:emit keys :key-pressed (gdk:keyval-from-name name) 0 modifiers)
                      (settle-layout-test-window 100))
                    (shown-p (widget) (gtk:widget-get-mapped widget)))
             (assert (shown-p (control :claude-widget)))
             (press "F5" '(:alt-mask))
             (assert (eq :conversation *view*))
             (assert (not (shown-p (control :claude-widget))))
             ;; Showing agents again restores the last agent layout.
             (press "F5" '(:alt-mask))
             (assert (eq :agents-left *view*))
             (assert (shown-p (control :claude-widget)))
             ;; Extra modifiers don't match.
             (press "F5" '(:alt-mask :shift-mask))
             (assert (eq :agents-left *view*))
             (assert (not (gtk:widget-get-visible (control :checklist-panel))))
             (press "F6" '(:super-mask))
             (assert (gtk:widget-get-visible (control :checklist-panel)))
             (assert (gtk:check-button-get-active (control :checklist-toggle)))
             (press "F6" '(:super-mask))
             (assert (not (gtk:widget-get-visible (control :checklist-panel))))
             (assert (not (terminal-visible-p)))
             (press "F7" '(:control-mask :shift-mask))
             (assert (terminal-visible-p))
             (assert (gtk:toggle-button-get-active (control :terminal)))
             ;; Ctrl+` keeps working alongside the configurable binding.
             (press "grave" '(:control-mask))
             (assert (not (terminal-visible-p))))))
    (setf (symbol-function 'new-terminal) original)
    (gtk:window-destroy *window*)))
(format t "~&Shortcut key handling UI checks passed.~%")
