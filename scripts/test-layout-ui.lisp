;;;; Loaded by test-conversation-ui.lisp after GTK initialization.
(in-package #:agent-duet)

(defun settle-layout-test-window (&optional (milliseconds 750))
  (let ((loop (glib:main-loop-new nil nil)))
    (glib:timeout-add glib:+priority-default+ milliseconds
                      (lambda () (glib:main-loop-quit loop) nil))
    (glib:main-loop-run loop)))

(let* ((*settings* (list :equal-agent-panels-version 2))
       (*controls* nil) (*panes* nil) (*workflow* nil) (*history* nil)
       (*directory* nil) (*view-only* nil) (*closing* nil) (*window* nil)
       (*claude* (make-instance 'claude-agent :id :claude :name "Claude"))
       (*codex* (make-instance 'codex-agent :id :codex :name "ChatGPT"))
       (*view* :sidebar)
       (expected nil))
  (dolist (view '(:sidebar :agents-left :panes))
    (setf *view* view expected nil)
    ;; Build fresh widgets for each restart, and reload the on-disk settings.
    (dotimes (restart 2)
      (let* ((window (destructuring-bind (width height) (saved-window-size)
                       (make-instance 'gtk:window :default-width width :default-height height)))
             (outer (make-instance 'gtk:paned :orientation :horizontal :position 420))
             (inner (make-instance 'gtk:paned :orientation :horizontal :position 600)))
        (unwind-protect
             (progn
               (setf *window* window *controls* nil *panes* nil)
               (dolist (agent (list *claude* *codex*))
                 (multiple-value-bind (pane widget) (make-agent-pane agent)
                   (push (cons (agent-id agent) pane) *panes*)
                   (setf (getf *controls* (if (eq agent *claude*) :claude-widget :codex-widget))
                         widget)))
               (setf (getf *controls* :agent-split) outer
                     (getf *controls* :conversation-split) inner
                     (getf *controls* :middle-widget) (make-middle-pane))
               (arrange-conversation view)
               (gtk:window-set-child window outer)
               (watch-conversation-allocation outer)
               (gtk:window-present window)
               (settle-layout-test-window)
               (when (zerop restart)
                 (gtk:window-set-default-size window 1500 960)
                 (settle-layout-test-window)
                 (gtk:paned-set-position outer 700)
                 (settle-layout-test-window)
                 (let ((before (uiop:read-file-string (settings-file))))
                   ;; A sustained drag must not write on every rendered frame.
                   (dotimes (step 5)
                     (gtk:paned-set-position inner (+ (if (eq view :panes) 450 250) step))
                     (settle-layout-test-window 40)
                     (assert (string= before (uiop:read-file-string (settings-file))))))
                 (settle-layout-test-window))
               (let ((positions (list (gtk:paned-get-position outer)
                                      (gtk:paned-get-position inner))))
                 (if (zerop restart)
                     (setf expected positions)
                     (assert (equal expected positions) ()
                             "~s changed after restart: ~s -> ~s" view expected positions))
                 ;; No remember-layout or close-request: saving must happen
                 ;; after allocation, before any application quit path.
                 (assert (equal positions (layout-positions view)) ()
                         "~s restart ~d: displayed ~s, saved ~s"
                         view restart positions (layout-positions view))
                 (setf *settings* nil)
                 (load-settings)
                 (assert (equal (saved-window-size)
                                (multiple-value-list (gtk:window-get-default-size window))))
                 (assert (eql (setting :window-maximized) (gtk:window-is-maximized window)))
                 (assert (equal positions (layout-positions view)))
                 ;; Hiding agents restores the exact layout, including dividers,
                 ;; even when the settings have been reloaded while hidden.
                 (setf (getf *controls* :agent-toggle) (make-instance 'gtk:button)
                       (getf *controls* :view)
                       (gtk:drop-down-new-from-strings (mapcar #'second *views*)))
                 (toggle-agents)
                 (settle-layout-test-window)
                 (assert (eq *view* :conversation))
                 (assert (not (gtk:widget-get-visible (control :claude-widget))))
                 (assert (not (gtk:widget-get-visible (control :codex-widget))))
                 (assert (string= "Show agents" (gtk:button-get-label (control :agent-toggle))))
                 (load-settings)
                 (toggle-agents)
                 (settle-layout-test-window)
                 (assert (eq *view* view))
                 (assert (gtk:widget-get-visible (control :claude-widget)))
                 (assert (gtk:widget-get-visible (control :codex-widget)))
                 (assert (equal positions (list (gtk:paned-get-position outer)
                                                (gtk:paned-get-position inner))))
                 (assert (= (position view *views* :key #'first)
                            (gtk:drop-down-get-selected (control :view))))
                 (assert (string= "Hide agents" (gtk:button-get-label (control :agent-toggle)))))
               (when (and (eq view :sidebar) (= restart 1))
                 (gtk:window-maximize window)
                 (settle-layout-test-window)
                 (load-settings)
                 (assert (gtk:window-is-maximized window))
                 (assert (eq t (setting :window-maximized)))
                 (gtk:window-unmaximize window)
                 (settle-layout-test-window)
                 (load-settings)
                 (assert (not (setting :window-maximized)))))
          (gtk:window-destroy window)
          (settle-layout-test-window))))))
(format t "~&Layout restart UI checks passed.~%")

;; Exercise the real header signal: synchronizing its toggle during startup
;; must not reenter SET-TERMINAL-VISIBLE with the default focus policy.
(let* ((*settings* nil) (*controls* nil) (*terminals* nil)
       (*current-terminal* nil) (*terminal-panel* nil)
       (*terminal-stack* nil) (*terminal-tabs* nil)
       (original (symbol-function 'new-terminal))
       (focus-requests nil))
  (unwind-protect
       (progn
         (setf (symbol-function 'new-terminal)
               (lambda (&key (focus t)) (push focus focus-requests)))
         (make-header)
         (make-terminal-panel)
         (set-terminal-visible t :focus nil)
         (assert (equal '(nil) focus-requests))
         (assert (gtk:toggle-button-get-active (control :terminal)))
         (set-terminal-visible nil)
         ;; A user click must still show the panel and request focus.
         (gtk:toggle-button-set-active (control :terminal) t)
         (assert (equal '(t nil) focus-requests)))
    (setf (symbol-function 'new-terminal) original)))

(let* ((*settings* nil) (*controls* nil)
       (*terminal-panel* (make-instance 'gtk:box :orientation :vertical))
       (split (make-instance 'gtk:paned :orientation :vertical :position 400))
       (window (make-instance 'gtk:window :default-width 800 :default-height 700)))
  (unwind-protect
       (progn
         (setf (getf *controls* :terminal-split) split)
         (gtk:paned-set-start-child split (make-instance 'gtk:box))
         (gtk:paned-set-end-child split *terminal-panel*)
         (gtk:window-set-child window split)
         (gtk:window-present window)
         (settle-layout-test-window)
         (let ((height (gtk:widget-get-height *terminal-panel*)))
           (assert (plusp height))
           (setf (getf *controls* :restore-terminal-height) height)
           (assert (not (restore-terminal-height)))
           (assert (not (control :restore-terminal-height)))
           (setf (getf *controls* :restore-terminal-height) (- height 20))
           (assert (restore-terminal-height))
           (assert (not (control :restore-terminal-height)))))
    (gtk:window-destroy window)
    (settle-layout-test-window)))
(format t "~&Terminal toggle and height UI checks passed.~%")

;; Checklist widths survive fresh widgets and an on-disk settings reload.
(let ((*settings* nil) (*controls* nil) (*checklist* nil) (*checklist-boxes* nil))
  (dolist (bad '(nil -1 0 100001 "wide" (300)))
    (setf *settings* (list :checklist-width bad))
    (assert (null (saved-checklist-width))))
  (setf *settings* (list :checklist-visible t))
  (dotimes (restart 2)
    (let* ((window (make-instance 'gtk:window :default-width 1100 :default-height 600))
           (split (make-instance 'gtk:paned :orientation :horizontal :position 700
                                 :resize-end-child nil))
           (panel (make-checklist-panel)))
      (unwind-protect
           (progn
             (setf (getf *controls* :narrow-layout) t
                   (getf *controls* :checklist-split) split
                   (getf *controls* :restore-checklist-width)
                   (or (saved-checklist-width) 300))
             (gtk:paned-set-start-child split (make-instance 'gtk:box))
             (gtk:paned-set-end-child split panel)
             (gtk:window-set-child window split)
             (gtk:window-present window)
             (settle-layout-test-window)
             ;; Pending startup allocations cannot overwrite the saved width.
             (remember-checklist-width)
             (when (= restart 1) (assert (= 380 (saved-checklist-width))))
             (restore-checklist-width)
             (settle-layout-test-window)
             (assert (= (if (zerop restart) 300 380) (gtk:widget-get-width panel)))
             (when (zerop restart)
               (gtk:paned-set-position split
                 (+ (gtk:paned-get-position split) (- (gtk:widget-get-width panel) 380)))
               (settle-layout-test-window))
             (remember-checklist-width)
             (set-checklist-visible nil)
             (settle-layout-test-window)
             (remember-checklist-width)
             (setf *settings* nil)
             (load-settings)
             (assert (= 380 (saved-checklist-width)))
             (set-checklist-visible t)
             (settle-layout-test-window)
             (restore-checklist-width)
             (settle-layout-test-window)
             (assert (= 380 (gtk:widget-get-width panel))))
        (gtk:window-destroy window)
        (setf *controls* nil)))))
(format t "~&Checklist layout checks passed.~%")
