;;;; Included by the GTK suite; exercise sidebar construction and folder inventory.
(in-package #:agent-duet)
(let* ((*settings* nil) (*controls* nil) (*checklist* nil)
       (*checklist-findings* nil) (*task-changes* nil)
       (book (make-workspace-sidebar)))
  (assert (= 4 (gtk:notebook-get-n-pages book)))
  (assert (eq book (control :checklist-panel)))
  (loop for index below 4
        for title in '("Tasks" "Changes" "Files" "Artifacts")
        for page = (gtk:notebook-get-nth-page book index)
        do (assert (equal title (gtk:label-get-text (gtk:notebook-get-tab-label book page)))))
  (let* ((tasks (gtk:notebook-get-nth-page book 0))
         (heading (gtk:widget-get-first-child tasks)))
    (assert (not (gtk:widget-get-visible heading)))
    (assert (not (gtk:widget-get-visible (gtk:widget-get-next-sibling heading)))))
  ;; The changes page must handle having no task, including repeated refreshes.
  (gtk:notebook-set-current-page book 1)
  (refresh-workspace-sidebar)
  (refresh-workspace-sidebar))
(let ((root (merge-pathnames (format nil "duet-sidebar-~a/" (make-uuid)) (uiop:temporary-directory))))
  (unwind-protect
       (progn
         (dolist (name '("src/main.lisp" "report.md" "figure.png" ".git/hidden.txt" "node_modules/skip.txt"))
           (let ((path (merge-pathnames name root)))
             (ensure-directories-exist path)
             (with-open-file (out path :direction :output) (write-string "test" out))))
         (let ((files (sidebar-files root)))
           (assert (equal '("figure.png" "report.md" "src/main.lisp") files))
           (assert (equal '("figure.png" "report.md") (remove-if-not #'sidebar-artifact-p files)))))
    (uiop:delete-directory-tree root :validate t)))
;; File filtering must preserve row identity, attach literal native paths,
;; and keep truncation visible even when the query has no matches.
(let* ((*controls* nil) (*directory* (uiop:temporary-directory))
       (names '(in-background)) (originals (mapcar #'symbol-function names))
       (worker nil) (done nil)
       (holder (new-agent-pane :chips (make-instance 'gtk:flow-box)))
       (path (merge-pathnames (make-pathname :name "literal*[name]" :type "txt") *directory*)))
  (unwind-protect
       (progn
         (setf (getf *controls* :composer-attachments) holder
               (symbol-function 'in-background)
               (lambda (name work callback) (declare (ignore name)) (setf worker work done callback)))
         (multiple-value-bind (page reload) (make-sidebar-file-page nil)
           (funcall reload)
           (assert worker)
           (funcall done (list (list (enough-namestring path *directory*) "other.md") t) nil)
           (let* ((widgets (shortcut-test-descendants page))
                  (search (find-if (lambda (w) (typep w 'gtk:search-entry)) widgets))
                  (list (find-if (lambda (w) (typep w 'gtk:list-box)) widgets))
                  (row (gtk:list-box-get-row-at-index list 0))
                  (second (gtk:list-box-get-row-at-index list 1))
                  (status (find-if (lambda (w) (and (typep w 'gtk:label)
                                                   (search "files omitted" (gtk:label-get-text w)))) widgets))
                  (attach (find-if (lambda (w) (and (typep w 'gtk:button)
                                                    (equal "+" (gtk:button-get-label w))))
                                  (shortcut-test-descendants row))))
             (assert status)
             (gobject:emit attach :clicked)
             (assert (equal (list (uiop:native-namestring path)) (agent-pane-attachments holder)))
             (gtk:editable-set-text search "literal")
             (gobject:emit search :search-changed)
             (assert (eq row (gtk:list-box-get-row-at-index list 0)))
             (assert (gtk:widget-get-visible row))
             (assert (not (gtk:widget-get-visible second)))
             (gtk:editable-set-text search "no match")
             (gobject:emit search :search-changed)
             (assert (search "No matching files" (gtk:label-get-text status)))
             (assert (search "files omitted" (gtk:label-get-text status))))))
    (loop for name in names for original in originals do (setf (symbol-function name) original))))
;; Reaching the exact cap is not truncation; finding another file is.
(let ((root (merge-pathnames (format nil "duet-cap-~a/" (make-uuid)) (uiop:temporary-directory))))
  (unwind-protect
       (progn
         (ensure-directories-exist root)
         (dotimes (i 3)
           (with-open-file (out (merge-pathnames (format nil "~d.txt" i) root) :direction :output)
             (write-string "test" out)))
         (multiple-value-bind (files truncated) (sidebar-files root :limit 3)
           (assert (= 3 (length files))) (assert (not truncated)))
         (multiple-value-bind (files truncated) (sidebar-files root :limit 2)
           (assert (= 2 (length files))) (assert truncated)))
    (uiop:delete-directory-tree root :validate t)))
;; Both a newly captured start and a finalized end refresh the selected page.
(let* ((*controls* nil) (*directory* (uiop:temporary-directory))
       (*workflow* (list :test)) (*task-changes* nil) (*request-preflight* nil)
       (task (%make-task-changes :workflow *workflow* :directory *directory*))
       (refreshes 0)
       (names '(in-background begin-task-changes repository-start-state finish-task-changes))
       (originals (mapcar #'symbol-function names)))
  (unwind-protect
       (progn
         (setf (getf *controls* :sidebar-refresh) (lambda () (incf refreshes))
               (symbol-function 'in-background)
               (lambda (name work done) (declare (ignore name)) (funcall done (funcall work) nil))
               (symbol-function 'begin-task-changes)
               (lambda (&rest args) (declare (ignore args)) task)
               (symbol-function 'repository-start-state)
               (lambda (&rest args) (declare (ignore args)) nil)
               (symbol-function 'finish-task-changes)
               (lambda (task) (setf (task-changes-final task) :taken) :taken))
         (snapshot-task-start *workflow* (lambda (state) (declare (ignore state))))
         (assert (= 1 refreshes))
         (setf (task-changes-final task) :pending)
         (assert (not (finish-task-end task)))
         (assert (= 2 refreshes)))
    (loop for name in names for original in originals do (setf (symbol-function name) original))))
;; Embedding creates a widget rather than a standalone window, and disposal
;; remains safe before the background load has completed.
(multiple-value-bind (widget dispose)
    (show-changes-window *directory* nil nil :embedded t)
  (assert (typep widget 'gtk:paned))
  (assert (functionp dispose))
  (funcall dispose)
  (funcall dispose))
(format t "~&Workspace sidebar UI checks passed.~%")
