           (assert (some (lambda (s) (search "Elapsed: 1m 5s" s)) texts))
           (assert (member "Open findings: 1" texts :test #'equal))
           (assert (member "Work: 2 review rounds" texts :test #'equal))
           (assert (member "No files changed." texts :test #'equal))
           (assert (some (lambda (s) (search "Cost unknown" s)) texts))))
    (setf (symbol-function 'in-background) background
          (symbol-function 'workflow-completion) completion)))
(format t "~&Task summary UI checks passed.~%")

;; Pending snapshot polling never rechecks Git eligibility or rebuilds the card.
(let* ((*history* nil) (*controls* nil)
       (*middle* (multiple-value-bind (messages scroller) (make-message-list)
                   (make-pane :messages messages :scroller scroller)))
       (workflow (make-instance 'workflow :lead (make-instance 'claude-agent)
                               :partner (make-instance 'codex-agent) :request "Pending files"))
       (*task-changes* (%make-task-changes :workflow workflow :start (make-snapshot) :end (make-snapshot)
                                         :final :pending))
       (background (symbol-function 'in-background))
       (completion (symbol-function 'workflow-completion))
       (timeout (symbol-function 'glib:timeout-add-seconds))
       (diff (symbol-function 'snapshot-changes))
       (poll nil) (completion-calls 0) (diff-calls 0))
  (setf (workflow-completion-data workflow)
        (list :outcome :unreviewed :summary "Keep this summary open or closed." :elapsed-seconds 1))
  (unwind-protect
       (progn
         (setf (symbol-function 'in-background)
               (lambda (name work done) (declare (ignore name)) (funcall done (funcall work) nil))
               (symbol-function 'workflow-completion)
               (lambda (w) (incf completion-calls) (workflow-completion-data w))
               (symbol-function 'glib:timeout-add-seconds)
               (lambda (priority seconds callback) (declare (ignore priority seconds)) (setf poll callback) 1)
               (symbol-function 'snapshot-changes)
               (lambda (&rest ignored) (declare (ignore ignored)) (incf diff-calls)
                 (list (make-snapshot-change :path "finished.lisp"))))
         (show-summary-card workflow)
         (let ((expander (first (find-widgets (pane-messages *middle*) 'gtk:expander))))
           (assert expander)
           (gtk:expander-set-expanded expander nil)
           (dotimes (n 2) (funcall poll))
           (assert (= 1 completion-calls))
           (assert (zerop diff-calls))
           (assert (eq expander (first (find-widgets (pane-messages *middle*) 'gtk:expander))))
           (assert (not (gtk:expander-get-expanded expander)))
           (setf (task-changes-final *task-changes*) :taken)
           (funcall poll)
           (assert (= 1 completion-calls))
           (assert (= 1 diff-calls))
           (assert (eq expander (first (find-widgets (pane-messages *middle*) 'gtk:expander))))
           (assert (not (gtk:expander-get-expanded expander)))
           (assert (some (lambda (label) (search "finished.lisp" (gtk:label-get-text label)))
                         (find-widgets (pane-messages *middle*) 'gtk:label)))))
    (setf (symbol-function 'in-background) background
          (symbol-function 'workflow-completion) completion
          (symbol-function 'glib:timeout-add-seconds) timeout
          (symbol-function 'snapshot-changes) diff)))
(format t "~&Pending summary snapshot UI checks passed.~%")

;; Commit selection refreshes its exact diff without touching real staging.
(let ((background (symbol-function 'in-background))
      (prepare (symbol-function 'prepare-repository-commit))
      (window nil) (calls nil))
  (unwind-protect
       (progn
         (setf (symbol-function 'in-background)
               (lambda (name work done) (declare (ignore name))
                 (handler-case (funcall done (funcall work) nil)
                   (error (e) (funcall done nil (princ-to-string e)))))
               (symbol-function 'prepare-repository-commit)
               (lambda (root &key start (paths '("new.txt")))
                 (declare (ignore root start))
                 (push paths calls)
                 (list :all '("old.txt" "new.txt") :dirty '("old.txt")
                       :changed '("old.txt" "new.txt") :paths paths :diff (format nil "~{~a~%~}" paths))))
         (setf window (show-commit-preview #p"/tmp/" :start '(:tree "start") :message "Add task output"))
         (let* ((checks (find-widgets window 'gtk:check-button))
                (old (find "old.txt  (changed before task)" checks :key #'gtk:check-button-get-label :test #'equal))
                (new (find "new.txt" checks :key #'gtk:check-button-get-label :test #'equal))
                (view (first (find-widgets window 'gtk:text-view))))
           (assert old) (assert new)
           (assert (not (gtk:check-button-get-active old)))
           (assert (gtk:check-button-get-active new))
           (assert (string= "new.txt
" (text-view-text view)))
           (gtk:check-button-set-active old t)
           (assert (member "old.txt" (first calls) :test #'equal))
           (assert (search "old.txt" (text-view-text view)))
           (assert (some (lambda (button) (equal "Select all changes" (gtk:button-get-label button)))
                         (find-widgets window 'gtk:button)))))
    (when window (gtk:window-close window))
    (setf (symbol-function 'in-background) background
          (symbol-function 'prepare-repository-commit) prepare)))
(format t "~&Commit selection UI checks passed.~%")

;; Dirty folders pause before task creation; continuing checks the same state.
(let* ((*directory* #p"/tmp/") (*workflow* nil) (*request-preflight* nil)
       (*controls* (list :input (make-input)))
       (*middle* (multiple-value-bind (messages scroller) (make-message-list)
                   (make-pane :messages messages :scroller scroller)))
       (names '(in-background selected-mode git-repository-p repository-state start-request-ready show-commit-preview))
       (originals (mapcar #'symbol-function names))
       (state '(:root #p"/tmp/" :status "dirty"))
       (continue nil) (committed nil) (started 0) (asked 0))
  (unwind-protect
       (progn
         (setf (symbol-function 'in-background)
               (lambda (name work done) (declare (ignore name)) (funcall done (funcall work) nil))
               (symbol-function 'selected-mode) (lambda () :review)
               (symbol-function 'git-repository-p) (lambda (root) (declare (ignore root)) t)
               (symbol-function 'repository-state) (lambda (root) (declare (ignore root)) state)
               (symbol-function 'start-request-ready) (lambda (&optional attachments) (declare (ignore attachments)) (incf started))
               (symbol-function 'show-commit-preview)
               (lambda (root &key opening-state on-continue on-committed) (declare (ignore root opening-state))
                 (incf asked) (setf continue on-continue committed on-committed)))
         (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "Implement a change" -1)
         (start-request)
         (assert (= 1 asked)) (assert (zerop started))
         ;; Cancelling has no callback and leaves the task unstarted.
         (funcall continue state)
         (assert (= 1 started))
         (let ((old state))
           (setf state '(:root #p"/tmp/" :status "new edits"))
           (funcall continue old)
           (assert (= 1 started)))
         (setf state '(:root #p"/tmp/" :status ""))
         (funcall committed '(:status :committed))
         (assert (= 2 started))
         (assert (= 1 asked)))
    (loop for name in names for original in originals do (setf (symbol-function name) original))))
(format t "~&Pre-task dirty repository UI checks passed.~%")

;; Continue uses the opening state even when preview fails or is still refreshing.
(let ((background (symbol-function 'in-background))
      (prepare (symbol-function 'prepare-repository-commit))
      (window nil) (pending nil) (hold nil) (fail-preview nil)
      (opening '(:root #p"/tmp/" :status "conflicts")) (continued nil))
  (unwind-protect
       (progn
         (setf (symbol-function 'in-background)
               (lambda (name work done) (declare (ignore name))
                 (if hold (setf pending (lambda () (funcall done (funcall work) nil)))
                     (handler-case (funcall done (funcall work) nil)
                       (error (e) (funcall done nil (princ-to-string e))))))
               (symbol-function 'prepare-repository-commit)
               (lambda (root &key start (paths '("new.txt")))
                 (declare (ignore root start))
                 (when fail-preview (error "Finish the current Git operation first."))
                 (list :all '("old.txt" "new.txt") :dirty '("old.txt") :changed '("old.txt" "new.txt")
                       :paths paths :diff "preview")))
         (labels ((button (label)
                    (find label (find-widgets window 'gtk:button) :key #'gtk:button-get-label :test #'equal))
                  (open-dialog ()
                    (setf window (show-commit-preview #p"/tmp/" :start '(:tree "start")
                                   :opening-state opening :on-continue (lambda (state) (setf continued state))))))
           (setf fail-preview t)
           (open-dialog)
           (assert (not (gtk:widget-get-visible (button "Commit and start task"))))
           (gobject:emit (button "Continue without committing") :clicked)
           (assert (eq opening continued))
           (setf fail-preview nil continued nil)
           (open-dialog)
           (let ((checks (find-widgets window 'gtk:check-button)))
             (gtk:check-button-set-active (first checks) t)
             (gobject:emit (button "Select task-changed files") :clicked)
             (let ((old (find "old.txt  (changed before task)" checks :key #'gtk:check-button-get-label :test #'equal)))
               (assert (not (gtk:check-button-get-active old))))
             (setf hold t)
             (gtk:check-button-set-active (first checks) t)
             (assert pending)
             (gobject:emit (button "Continue without committing") :clicked)
             (assert (eq opening continued))
             (funcall pending))))
    (when window (gtk:window-close window))
    (setf (symbol-function 'in-background) background
          (symbol-function 'prepare-repository-commit) prepare)))
(format t "~&Commit preview failure, preset, and pending Continue checks passed.~%")

;; Context controls share one local reset path; neither composer sends /clear.
(let* ((*history* nil) (*directory* nil) (*settings* nil) (*controls* nil)
       (*panes* nil) (*workflow* nil) (*view-only* nil) (*view* :sidebar)
       (*claude* (make-instance 'claude-agent))
       (*codex* (make-instance 'codex-agent))
       (*middle* (multiple-value-bind (messages scroller) (make-message-list)
                   (make-pane :messages messages :scroller scroller)))
       (widgets nil))
  (dolist (agent (list *claude* *codex*))
    (multiple-value-bind (pane widget) (make-agent-pane agent)
      (push (cons (agent-id agent) pane) *panes*)
      (push (cons agent widget) widgets)))
  (setf *controls* (list :folder (make-instance 'gtk:button)
                         :permission (make-instance 'gtk:button)))
  (make-middle-pane)
  ;; The shared header switches formatters once a message creates a workflow.
  ;; Context must survive that switch, subsequent usage updates and completion.
  (dolist (agent (list *claude* *codex*))
    (pane-update-status (agent-pane-of agent))
    (assert (search "Context: unknown" (agent-activity agent))))
  (let ((*workflow* (make-instance 'workflow :lead *claude* :partner *codex* :request "Task")))
    (setf (workflow-state *workflow*) :running)
    (refresh-activity)
    (dolist (key '(:claude-activity :codex-activity))
      (assert (search "Context: unknown" (gtk:label-get-text (control key)))))
    (setf (agent-context-tokens *claude*) 120
          (agent-context-tokens *codex*) 240
          (agent-context-limit *codex*) 1000)
    (dolist (state '(:running :finished))
      (setf (workflow-state *workflow*) state)
      (pane-update-status (agent-pane-of *claude*))
      (pane-update-status (agent-pane-of *codex*))
      (assert (search "Context ≈: 120 tokens" (gtk:label-get-text (control :claude-activity))))
      (assert (search "Context: 240 / 1,000 tokens" (gtk:label-get-text (control :codex-activity))))))
  ;; No recipient control means both, and must clear rather than start a task.
  (setf (claude-agent-session-id *claude*) "old" (claude-agent-started *claude*) t
        (codex-agent-thread-id *codex*) "old")
  (let ((count (conversation-child-count (pane-messages *middle*))))
    (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "/clear" -1)
    (send-composer-message)
    (assert (null (agent-conversation-handle *claude*)))
    (assert (null (agent-conversation-handle *codex*)))
    (assert (string= "" (text-view-text (control :input))))
    (assert (= count (conversation-child-count (pane-messages *middle*)))))
  (let ((pane (agent-pane-of *claude*)))
    (setf (agent-context-tokens *claude*) 120)
    (pane-update-status pane)
    (assert (search "Context ≈: 120 tokens" (gtk:label-get-text (pane-status pane))))
    (gtk:text-buffer-set-text (gtk:text-view-get-buffer (pane-input pane)) "/clear" -1)
    (gobject:emit (pane-send pane) :clicked)
    (assert (null (agent-context-tokens *claude*)))
    (assert (search "Context: unknown" (gtk:label-get-text (pane-status pane))))
    (assert (string= "" (text-view-text (pane-input pane)))))
  ;; An idle participant still owns context needed by its next workflow step.
  (setf *workflow* (make-instance 'workflow :lead *claude* :partner *codex* :request "Task")
        (workflow-state *workflow*) :running
        (codex-agent-thread-id *codex*) "keep")
  (assert (not (new-conversation *codex*)))
  (assert (string= "keep" (agent-conversation-handle *codex*)))
  (gtk:text-buffer-set-text (gtk:text-view-get-buffer (pane-input (agent-pane-of *codex*))) "/clear" -1)
  (gobject:emit (pane-send (agent-pane-of *codex*)) :clicked)
  (assert (string= "keep" (agent-conversation-handle *codex*)))
  (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "/clear" -1)
  (send-composer-message)
  (assert (string= "keep" (agent-conversation-handle *codex*)))
  (assert (string= "/clear" (text-view-text (control :input))))
  ;; Typed clears save the reset note, without recording a model prompt.
  (let ((*workflow* nil) (*directory* #p"/tmp/")
        (*history* (make-history #p"/tmp/"))
        (save (symbol-function 'save-current-history)) (saved 0))
    (unwind-protect
         (progn
           (setf (symbol-function 'save-current-history) (lambda () (incf saved)))
           (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "/clear" -1)
           (send-composer-message)
           (assert (= 2 saved))
           (assert (= 2 (length (history-entries *history*))))
           (assert (every (lambda (entry)
                            (and (eq :note (getf entry :kind))
                                 (string= "New conversation." (getf entry :text))))
                          (history-entries *history*))))
      (setf (symbol-function 'save-current-history) save)))
  ;; Standalone busy work retains the button's cancel-and-reset behavior.
  (setf *workflow* nil (agent-busy *codex*) t)
  (assert (new-conversation *codex*))
  (assert (not (agent-busy *codex*)))
  (assert (null (agent-conversation-handle *codex*))))
(format t "~&Context status, composer clear, workflow guard, and busy reset checks passed.~%")

;; Search traverses rendered labels (including collapsed details), counts
;; occurrences, handles Unicode offsets, and does not search the composer.
(multiple-value-bind (messages scroller) (make-message-list)
  (let* ((pane (make-pane :messages messages :scroller scroller))
         (label (make-instance 'gtk:label :label "λ Alpha alpha"))
         (detail (make-instance 'gtk:expander :label "Details" :expanded nil :child label)))
    (gtk:label-set-markup label "<b>λ Alpha</b> alpha")
    (gtk:box-append messages detail)
    (let ((matches (pane-search-matches pane "ALPHA")))
      (assert (= 2 (length matches)))
      (assert (equal '(2 7) (subseq (first matches) 1 3)))
      (assert (equal '(8 13) (subseq (second matches) 1 3)))
      (assert (null (pane-search-matches pane "")))
      (assert (null (pane-search-matches pane "absent"))))
    (let* ((*middle* pane) (*panes* nil) (*checklist* nil) (*checklist-findings* nil)
           (*window* nil)
           (window (show-pane-search))
           (box (gtk:window-get-child window))
           (selector (gtk:widget-get-first-child box))
           (entry (gtk:widget-get-next-sibling selector))
           (row (gtk:widget-get-next-sibling entry))
           (count (gtk:widget-get-first-child row))
           (previous (gtk:widget-get-next-sibling count))
           (next (gtk:widget-get-next-sibling previous))
           (highlight-all (gtk:widget-get-next-sibling row)))
      (assert (not (gtk:check-button-get-active highlight-all)))
      (assert (null *pane-search-scroller*))
      (gtk:editable-set-text entry "alpha")
      (assert (null *pane-search-scroller*))
      (assert (string= "2 matches" (gtk:label-get-text count)))
      (gobject:emit next :clicked)
      (assert *pane-search-highlight*)
      (assert (eq scroller *pane-search-scroller*))
      (assert (string= "1 of 2" (gtk:label-get-text count)))
      (assert (gtk:expander-get-expanded detail))
      ;; Force layout as a displayed transcript would before navigating away.
      (assert (search "3 8 background"
                      (pango:attr-list-to-string
                       (pango:layout-get-attributes (gtk:label-get-layout label)))))
      (gobject:emit previous :clicked)
      (assert (string= "2 of 2" (gtk:label-get-text count)))
      (let ((attributes (pango:attr-list-to-string
                         (pango:layout-get-attributes (gtk:label-get-layout label)))))
        (assert (search "9 14 background" attributes))
        (assert (not (search "3 8 background" attributes))))
      (gtk:check-button-set-active highlight-all t)
      (let ((attributes (pango:attr-list-to-string
                         (pango:layout-get-attributes (gtk:label-get-layout label)))))
        (assert (search "3 8 background" attributes))
        (assert (search "9 14 background" attributes)))
      (gobject:emit next :clicked)
      (assert (string= "1 of 2" (gtk:label-get-text count)))
      (gtk:check-button-set-active highlight-all nil)
      (let ((attributes (pango:attr-list-to-string
                         (pango:layout-get-attributes (gtk:label-get-layout label)))))
        (assert (search "3 8 background" attributes))
        (assert (not (search "9 14 background" attributes))))
      (gtk:check-button-set-active highlight-all t)
      (gtk:editable-set-text entry "missing")
      (assert (null *pane-search-scroller*))
      (assert (null *pane-search-highlight*))
      (assert (string= "0 8 weight bold"
                       (pango:attr-list-to-string
                        (pango:layout-get-attributes (gtk:label-get-layout label)))))
      (assert (string= "No matches" (gtk:label-get-text count)))
      (assert (not (gtk:widget-get-sensitive next)))
      (gtk:editable-set-text entry "alpha")
      (gobject:emit next :clicked)
      (assert *pane-search-scroller*)
      (gtk:window-close window)
      (assert (null *pane-search-highlight*))
      (assert (string= "0 8 weight bold"
                       (pango:attr-list-to-string
                        (pango:layout-get-attributes (gtk:label-get-layout label)))))
      (assert (null *pane-search-scroller*)))))

;; Finding an early match must visibly scroll away from the bottom; transcript
;; auto-follow must not immediately override the search position.
(multiple-value-bind (messages scroller) (make-message-list)
  (let* ((pane (make-pane :messages messages :scroller scroller))
         (window (make-instance 'gtk:window :default-width 500 :default-height 300))
         (*pane-search-scroller* scroller))
    (labels ((settle ()
               (let ((loop (glib:main-loop-new nil nil)))
                 (glib:timeout-add glib:+priority-default+ 250
                                   (lambda () (glib:main-loop-quit loop) nil))
                 (glib:main-loop-run loop))))
      (unwind-protect
           (progn
             (pane-note pane "Early target")
             (dotimes (i 35) (pane-note pane (format nil "Filler ~d" i)))
             (gtk:window-set-child window scroller)
             (gtk:window-present window)
             (settle)
             (let ((adjustment (gtk:scrolled-window-get-vadjustment scroller)))
               (scroll-adjustment-to-end adjustment)
               (assert (> (gtk:adjustment-get-value adjustment) 100d0))
               (reveal-pane-search-match pane (first (pane-search-matches pane "target")))
               (settle)
               (assert (< (gtk:adjustment-get-value adjustment) 60d0))
               (pane-note pane "Later streamed reply")
               (settle)
               (assert (< (gtk:adjustment-get-value adjustment) 60d0))))
        (gtk:window-destroy window)))))

;; A missing shared pane must not shift the selector names away from their panes.
(multiple-value-bind (messages scroller) (make-message-list)
  (let* ((*middle* nil) (*panes* nil) (*checklist-findings* nil) (*window* nil)
         (*checklist* (make-pane :messages messages :scroller scroller))
         (window (show-pane-search))
         (selector (gtk:widget-get-first-child (gtk:window-get-child window)))
         (model (gtk:drop-down-get-model selector)))
    (assert (string= "Checklist" (gtk:string-list-get-string model 0)))
    (assert (= 1 (gio:list-model-get-n-items model)))
    (gtk:window-close window)))

;; User panel shortcuts take priority over the built-in Find binding.
(let* ((window (make-instance 'gtk:window))
       (keys (setup-window-keys window))
       (original-panel (symbol-function 'run-panel-shortcut))
       (original-find (symbol-function 'show-pane-search))
       (original-event (symbol-function 'event-panel-shortcut))
       (panel-called nil) (find-called nil))
  (unwind-protect
       (progn
         (setf (symbol-function 'event-panel-shortcut)
               (lambda (&rest args) (declare (ignore args)) :agents-shortcut)
               (symbol-function 'run-panel-shortcut)
               (lambda (action) (setf panel-called action) t)
               (symbol-function 'show-pane-search)
               (lambda () (setf find-called t)))
         (gobject:emit keys :key-pressed (gdk:keyval-from-name "f") 0
                       (if (uiop:os-macosx-p) '(:meta-mask) '(:control-mask)))
         (assert (eq :agents-shortcut panel-called))
         (assert (null find-called)))
    (setf (symbol-function 'run-panel-shortcut) original-panel
          (symbol-function 'show-pane-search) original-find
          (symbol-function 'event-panel-shortcut) original-event)
    (gtk:window-destroy window)))

;; Search highlighting uses text attributes, not the focus-dependent selection.
;; Byte ranges must account for Unicode; restoring must preserve existing styling.
(let* ((label (make-instance 'gtk:label :selectable t))
       (attributes (pango:attr-list-new)))
  (gtk:label-set-markup label "<b>λ Alpha alpha</b>")
  (pango:attr-list-insert attributes (pango:attr-foreground-new 50000 10000 10000))
  (gtk:label-set-attributes label attributes)
  (let ((original (pango:attr-list-to-string (gtk:label-get-attributes label))))
    (unwind-protect
         (progn
           (highlight-pane-search-match label 2 7)
           (let ((highlight (pango:attr-list-to-string (gtk:label-get-attributes label))))
             (assert (search "3 8 background" highlight))
             (assert (search "3 8 foreground" highlight)))
           (highlight-pane-search-match label 8 13)
           (let ((highlight (pango:attr-list-to-string (gtk:label-get-attributes label))))
             (assert (search "9 14 background" highlight))
             (assert (not (search "3 8 background" highlight))))
           (clear-pane-search-highlight)
           (assert (string= original (pango:attr-list-to-string (gtk:label-get-attributes label)))))
      (clear-pane-search-highlight))))
(let ((label (make-instance 'gtk:label :label "plain")))
  (highlight-pane-search-match label 0 5)
  (clear-pane-search-highlight)
  (assert (null (gtk:label-get-attributes label))))

;; Moving between different labels must restore every previous label, including
;; labels that had no explicit attributes before the search.
(let ((first (make-instance 'gtk:label :label "alpha alpha"))
      (second (make-instance 'gtk:label :label "alpha")))
  (unwind-protect
       (progn
         (highlight-pane-search-matches (list (list first 0 5) (list first 6 11)
                                             (list second 0 5)))
         (assert (= 2 (length *pane-search-highlight*)))
         (highlight-pane-search-match second 0 5)
         (assert (null (gtk:label-get-attributes first)))
         (clear-pane-search-highlight)
         (assert (null (gtk:label-get-attributes second))))
    (clear-pane-search-highlight)))

;; Startup snapshots must not execute repository I/O in the button callback.
(let* ((*directory* #p"/tmp/") (*workflow* (list :starting))
       (*task-changes* nil) (*request-preflight* nil)
       (names '(in-background begin-task-changes repository-start-state))
       (originals (mapcar #'symbol-function names))
       (work nil) (done nil) (captured nil) (started nil))
  (unwind-protect
       (progn
         (setf (symbol-function 'in-background)
               (lambda (name worker callback)
                 (declare (ignore name)) (setf work worker done callback))
               (symbol-function 'begin-task-changes)
               (lambda (workflow directory)
                 (setf captured t)
                 (%make-task-changes :workflow workflow :directory directory))
               (symbol-function 'repository-start-state)
               (lambda (&rest args) (declare (ignore args)) :baseline))
         (snapshot-task-start *workflow* (lambda (state) (setf started state)))
         (assert *request-preflight*)
         (assert (not captured))
         ;; Repeated Return must leave the pending startup alone.
         (send-composer-message)
         (assert (not captured))
         (let ((result (funcall work)))
           (assert captured)
           (assert (not started))
           (funcall done result nil))
         (assert (eq :baseline started))
         (assert (not *request-preflight*))
         ;; A completion for a folder left during capture cannot start agents.
         (setf started nil)
         (snapshot-task-start *workflow* (lambda (state) (setf started state)))
         (setf *directory* #p"/elsewhere/")
         (funcall done (funcall work) nil)
         (assert (not started)))
    (loop for name in names for original in originals
          do (setf (symbol-function name) original))))
(format t "~&Background startup snapshot UI checks passed.~%")
