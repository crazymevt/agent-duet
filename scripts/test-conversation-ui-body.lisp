;;;; GTK checks loaded inside the isolated configuration test runner.
(push (truename ".") asdf:*central-registry*)
(ql:quickload :agent-duet)
(in-package #:agent-duet)
(gtk:init)

(defun conversation-child-count (widget)
  (loop for child = (gtk:widget-get-first-child widget) then (gtk:widget-get-next-sibling child)
        while child count child))

;; Each identity has a distinct, artwork-free badge, with the same gutter.
(let ((*middle* (multiple-value-bind (messages scroller) (make-message-list)
                  (make-pane :messages messages :scroller scroller))))
  (loop for side in '(:user :claude :codex)
        for initial in '("Y" "C" "G")
        do (let* ((bubble (middle-bubble side "Speaker" "Reply"))
                  (heading (gtk:widget-get-first-child bubble))
                  (badge (gtk:widget-get-first-child heading))
                  (body (gtk:widget-get-last-child bubble)))
             (assert (string= initial (gtk:label-get-text badge)))
             (assert (string= "Speaker" (gtk:label-get-text (conversation-heading-label bubble))))
             (assert (= +conversation-gutter+ (gtk:widget-get-margin-start body)))
             (assert (= +conversation-gutter+
                        (+ +conversation-chat-head-size+ (gtk:box-get-spacing heading))))
             (assert (eq :none (gtk:accessible-get-accessible-role badge)))
             (assert (plusp (length (gtk:widget-get-tooltip-text badge))))
             (assert (gtk:label-get-wrap (conversation-heading-label bubble))))))

(let* ((*history* nil) (*directory* nil) (*settings* nil) (*controls* nil) (*panes* nil) (*workflow* nil) (*view-only* nil)
       (*view* :sidebar)
       (*claude* (make-instance 'claude-agent :id :claude :name "Claude"))
       (*codex* (make-instance 'codex-agent :id :codex :name "ChatGPT"))
       (*middle* (multiple-value-bind (messages scroller) (make-message-list)
                   (make-pane :messages messages :scroller scroller))))
  (dolist (agent (list *claude* *codex*))
    (multiple-value-bind (pane widget) (make-agent-pane agent)
      (declare (ignore widget))
      (push (cons (agent-id agent) pane) *panes*)))
  (let ((claude (agent-pane-of *claude*)) (codex (agent-pane-of *codex*)))
    (pane-delta claude "Looking ")
    (pane-delta codex "Checking")
    (let ((source (agent-pane-stream-timeout claude)))
      (pane-delta claude "at this")
      (assert (eql source (agent-pane-stream-timeout claude)))
      (assert (string= "Looking at this" (agent-pane-stream-text claude))))
    (flush-pane-stream claude)
    (flush-pane-stream codex)
    (assert (string= "Looking at this" (gtk:label-get-text (agent-pane-conversation-label claude))))
    (assert (string= "Checking" (gtk:label-get-text (agent-pane-conversation-label codex))))
    ;; A tool may interrupt streaming before its timer has published the tail.
    (pane-delta codex " the full tail")
    (let ((stream-label (agent-pane-stream-label codex))
          (conversation-label (agent-pane-conversation-label codex)))
      (assert (agent-pane-stream-timeout codex))
      (pane-tool codex "stream-interruption" "git status")
      (assert (null (agent-pane-stream-timeout codex)))
      (assert (string= "Checking the full tail" (gtk:label-get-text stream-label)))
      (assert (string= "Checking the full tail" (gtk:label-get-text conversation-label))))
    (pane-delta codex "Clear before the timer fires")
    (clear-agent-pane codex)
    (assert (null (agent-pane-stream-timeout codex)))
    (let ((body (agent-pane-conversation-box claude)))
      (pane-delta claude " pending")
      (pane-text claude "Looking at this.")
      (assert (null (agent-pane-stream-timeout claude)))
      (assert (string= "Looking at this."
                       (gtk:label-get-text (gtk:widget-get-first-child body)))))
    (let* ((bubble (gtk:widget-get-first-child (pane-messages *middle*)))
           (count (conversation-child-count (pane-messages *middle*))))
      (assert (= 3 (conversation-child-count bubble)))
      ;; Task completion must promote the live reply, preserving its command.
      (middle-message *claude* *codex* (format nil "Looking at this.~%") :work)
      (assert (= count (conversation-child-count (pane-messages *middle*))))
      (assert (search "Claude → ChatGPT" (gtk:label-get-text (conversation-heading-label bubble)))))
    (let ((old (agent-pane-conversation-activity claude)))
      (assert (= +conversation-gutter+ (gtk:widget-get-margin-start old)))
      (pane-tool claude "one" "git status")
      (assert (string= "Running · git status" (gtk:label-get-text old)))
      (assert (eq (gtk:widget-get-parent old)
                  (gtk:widget-get-first-child (pane-messages *middle*))) nil
              "Commands belong below their agent's message, even when another agent replied later")
      (pane-tool-result claude "one" "clean" nil)
      (assert (string= "Finished · git status" (gtk:label-get-text old)))
      (pane-text claude "Next step")
      (assert (not (gtk:widget-get-visible (agent-pane-conversation-activity claude))))
      (assert (string= "" (gtk:label-get-text (agent-pane-conversation-activity claude))))
      (pane-tool-result claude "one" "late result" nil)
      (assert (not (gtk:widget-get-visible (agent-pane-conversation-activity claude))))
      (pane-tool claude "two" "git diff")
      (assert (string= "Finished · git status" (gtk:label-get-text old)))
      (assert (string= "Running · git diff"
                       (gtk:label-get-text (agent-pane-conversation-activity claude)))))
    ;; A new turn starting with tools must leave the old handoff alone,
    ;; and its first text must fill the command's pending bubble.
    (let ((old (agent-pane-conversation-activity claude))
          (count (conversation-child-count (pane-messages *middle*))))
      (agent-pane-event *claude* :turn-done :text "Done")
      (agent-pane-event *claude* :prompt :text "New task")
      (pane-tool claude "three" "ls")
      (assert (string= "Claude is working…"
                       (gtk:label-get-text (agent-pane-conversation-label claude))))
      (let ((body (agent-pane-conversation-box claude)))
        (pane-tool-result claude "three" "files" nil)
        (pane-thinking claude "Considering those files")
        (assert (eq body (agent-pane-conversation-box claude))))
      (assert (= (1+ count) (conversation-child-count (pane-messages *middle*))))
      (assert (string= "Running · git diff" (gtk:label-get-text old)))
      (assert (= (1+ count) (conversation-child-count (pane-messages *middle*))))
      (pane-delta claude "Command first ")
      (flush-pane-stream claude)
      (assert (string= "Command first "
                       (gtk:label-get-text (agent-pane-conversation-label claude))))
      (pane-text claude "Command first reply")
      (assert (= (1+ count) (conversation-child-count (pane-messages *middle*))))
      (assert (string= "Finished · ls"
                       (gtk:label-get-text (agent-pane-conversation-activity claude)))))
    ;; A separate CLI result may combine blocks and match neither verbatim.
    (let* ((activity (agent-pane-conversation-activity claude))
           (bubble (gtk:widget-get-parent activity))
           (count (conversation-child-count (pane-messages *middle*))))
      (middle-message *claude* *codex* "Combined final result" :work)
      (assert (= count (conversation-child-count (pane-messages *middle*))))
      (assert (string= "Combined final result"
                       (gtk:label-get-text
                        (gtk:widget-get-first-child
                         (gtk:widget-get-next-sibling (gtk:widget-get-first-child bubble))))))
      (assert (eq activity (gtk:widget-get-last-child bubble))))
    ;; Combined handoffs contain each block once, keeping earlier commands.
    (begin-conversation-turn claude)
    (pane-text claude "First block")
    (pane-tool claude "four" "pwd")
    (let ((first (gtk:widget-get-parent (agent-pane-conversation-activity claude))))
      (pane-text claude "Second block")
      (pane-tool claude "five" "git status")
      (pane-text claude "Last block")
      (pane-tool claude "six" "git diff")
      (middle-message *claude* *codex* (format nil "First block~%~%Second block~%~%Last block") :work)
      (assert (null (gtk:widget-get-parent first)))
      (let* ((handoff (gtk:widget-get-last-child (pane-messages *middle*)))
             (body (gtk:widget-get-next-sibling (gtk:widget-get-first-child handoff))))
        (assert (equal '("Running · pwd" "Running · git status" "Running · git diff")
                       (loop for child = (gtk:widget-get-next-sibling body)
                               then (gtk:widget-get-next-sibling child)
                             while child collect (gtk:label-get-text child))))))
    ;; Identical start notifications are ignored; a full title is a useful refinement.
    (let ((*history* (make-history #p"/tmp/")) (*directory* #p"/tmp/"))
      (pane-tool claude "dedup" "Bash")
      (pane-tool claude "dedup" "Bash")
      (assert (= 1 (length (history-entries *history*))))
      (pane-tool claude "dedup" "git status")
      (assert (= 2 (length (history-entries *history*)))))
    ;; Command-only turns must not keep claiming work after completion,
    ;; a new prompt, or a handoff. Empty deltas do not count as reply text.
    (dolist (ending '(:done :prompt :handoff))
      (begin-conversation-turn claude)
      (pane-tool claude "only-command" "ls")
      (let ((label (agent-pane-conversation-label claude)))
        (pane-delta claude "")
        (assert (agent-pane-conversation-placeholder-p claude))
        (assert (string= "Claude is working…" (gtk:label-get-text label)))
        (assert (null (agent-pane-stream-box claude)))
        (pane-tool-result claude "only-command" "files" nil)
        (ecase ending
          (:done (agent-pane-event *claude* :turn-done))
          (:prompt (begin-conversation-turn claude))
          (:handoff (middle-message *claude* *codex* "Done" :work)))
        (assert (string= "" (gtk:label-get-text label)))
        (assert (not (agent-pane-conversation-placeholder-p claude)))))
    (pane-text claude "Ready")
    (let ((strip (make-activity-strip)))
      (declare (ignore strip))
      (assert (gtk:widget-get-visible (control :claude-activity)))
      (assert (gtk:widget-get-visible (control (agent-setting-key *claude* "WORKFLOW-STATUS-PILL"))))
      (assert (= 2 (length (agent-pane-activity-labels claude)))))
    (clear-agent-pane claude)
    (assert (null (agent-pane-conversation-activity claude)))
    (assert (= 1 (length (agent-pane-activity-labels claude))))
    (clear-agent-pane codex)
    (clear-box (pane-messages *middle*))
    ;; Replayed command-only turns, including interrupted saves, are not live.
    (dolist (kind '(:activity :tool))
      (let ((history (make-history #p"/tmp/")))
        (history-add-entry history :claude :prompt "Command only")
        (history-add-entry history :claude kind "ls")
        (replay-history history)
        (assert (not (agent-pane-conversation-placeholder-p claude)))
        (assert (string= "" (gtk:label-get-text (agent-pane-conversation-label claude)))))
      (clear-agent-pane claude)
      (clear-box (pane-messages *middle*)))
    (let ((history (make-history #p"/tmp/")))
      (history-add-entry history :claude :text "Saved reply")
      (history-add-entry history :middle :text (format nil "Claude → ChatGPT~%~%Saved reply"))
      (replay-history history)
      (assert (= 1 (conversation-child-count (pane-messages *middle*))))
      (assert (not (gtk:widget-get-visible (agent-pane-conversation-activity claude)))))
    (clear-agent-pane claude)
    (clear-box (pane-messages *middle*))
    (let ((history (make-history #p"/tmp/")))
      (history-add-entry history :claude :prompt "Task one")
      (history-add-entry history :claude :activity "Running · ls")
      (history-add-entry history :claude :activity "Finished · ls")
      (history-add-entry history :claude :text "Intermediate reply")
      (history-add-entry history :claude :text "Final reply")
      (history-add-entry history :middle :text (format nil "Claude → ChatGPT~%~%Final reply"))
      (history-add-entry history :claude :prompt "Task two")
      (history-add-entry history :claude :text "Direct reply")
      (replay-history history)
      (assert (= 3 (conversation-child-count (pane-messages *middle*))))
      (let ((first (gtk:widget-get-first-child (pane-messages *middle*))))
        (assert (string= "Finished · ls" (gtk:label-get-text (gtk:widget-get-last-child first)))))
      (assert (not (gtk:widget-get-visible (agent-pane-conversation-activity claude)))))))
;; Markdown images: local files as thumbnails that open, the rest as text.
(defun widget-children (widget)
  (loop for child = (gtk:widget-get-first-child widget) then (gtk:widget-get-next-sibling child)
        while child collect child))

(defun find-widgets (widget type)
  (append (and (typep widget type) (list widget))
          (mapcan (lambda (child) (find-widgets child type)) (widget-children widget))))

(let* ((root (uiop:ensure-directory-pathname
              (string-trim '(#\Space #\Newline) (uiop:run-program '("mktemp" "-d") :output :string))))
       (*directory* root) (*image-directory* nil))
  (unwind-protect
       (let ((texture (gdk:texture-new-for-pixbuf (gdk-pixbuf:pixbuf-new :rgb nil 8 800 600))))
         (ensure-directories-exist (merge-pathnames "mock ups/" root))
         (gdk:texture-save-to-png texture (namestring (merge-pathnames "mock.png" root)))
         (gdk:texture-save-to-png texture (namestring (merge-pathnames "mock ups/home 2.png" root)))
         (with-open-file (out (merge-pathnames "broken.png" root) :direction :output)
           (write-string "not an image" out))
         (flet ((rendered (text)
                  (let ((box (make-instance 'gtk:box :orientation :vertical)))
                    (render-markdown box text)
                    (widget-children box))))
           ;; Text around the image stays, in order; the thumbnail is bounded.
           (destructuring-bind (before button after)
               (rendered (format nil "Here is the **mockup**: ![Home screen](mock.png) for review~%Next line"))
             (assert (string= "Here is the mockup:  for review" (gtk:label-get-text before)))
             (assert (typep button 'gtk:button))
             (let ((picture (first (find-widgets button 'gtk:picture))))
               (assert picture)
               ;; Keep a visible floor while allowing layout below natural size.
               (multiple-value-bind (minimum natural) (gtk:widget-measure picture :horizontal -1)
                 (assert (= minimum 240))
                 (assert (= natural 640)))
               (multiple-value-bind (minimum natural) (gtk:widget-measure picture :vertical -1)
                 (assert (= minimum 180))
                 (assert (= natural 480)))
               (assert (= (gdk:paintable-get-intrinsic-width (gtk:picture-get-paintable picture)) 640))
               (assert (= (gdk:paintable-get-intrinsic-height (gtk:picture-get-paintable picture)) 480)))
             (assert (search "Home screen" (gtk:label-get-text (first (find-widgets button 'gtk:label)))))
             (assert (string= "Next line" (gtk:label-get-text after))))
           ;; The actual message scroller must still fit a 300px-wide pane.
           (multiple-value-bind (messages scroller) (make-message-list)
             (render-markdown messages "![Generated image](mock.png)")
             (assert (<= (gtk:widget-measure scroller :horizontal -1) 300)))
           ;; Realize the scroller: requests alone don't prove displayed size.
           (dolist (window-width '(900 300))
             (multiple-value-bind (messages scroller) (make-message-list)
               (let ((window (make-instance 'gtk:window :default-width window-width :default-height 700)))
                 (unwind-protect
                      (progn
                        (render-markdown messages "![Generated image](mock.png)")
                        (gtk:window-set-child window scroller)
                        (gtk:window-present window)
                        (let ((loop (glib:main-loop-new nil nil)))
                          (glib:timeout-add glib:+priority-default+ 300
                                            (lambda () (glib:main-loop-quit loop) nil))
                          (glib:main-loop-run loop))
                        (let* ((picture (first (find-widgets messages 'gtk:picture)))
                               (width (gtk:widget-get-width picture)))
                          (if (= window-width 900)
                              (assert (= width 640))
                              (progn
                                (assert (<= 240 width 300))
                                (assert (<= (gtk:widget-get-width window) 300))))))
                   (gtk:window-destroy window)))))
           ;; Wrapped alt text uses the same normalized input for text and images.
           (let ((children (rendered (format nil "Before ![Home~%screen](mock.png) after"))))
             (assert (= 2 (length children)))
             (assert (string= "Before  after" (gtk:label-get-text (first children))))
             (assert (typep (second children) 'gtk:button)))
           ;; Failed and size-limited previews are cached and remain openable.
           (let ((*image-thumbnails* (make-hash-table :test #'equal)))
             (let ((path (merge-pathnames "broken.png" root)))
               (assert (null (image-thumbnail-texture path)))
               (assert (eq :none (gethash (list (namestring path) (file-write-date path))
                                          *image-thumbnails*)))))
           (let ((*image-thumbnails* (make-hash-table :test #'equal))
                 (*image-preview-max-pixels* 1))
             (assert (null (image-thumbnail-texture (merge-pathnames "mock.png" root)))))
           (let ((*image-thumbnails* (make-hash-table :test #'equal))
                 (*image-preview-max-bytes* 1))
             (assert (null (image-thumbnail-texture (merge-pathnames "mock.png" root)))))
           ;; An image alone leaves no empty label; <…> paths may hold spaces;
           ;; absolute paths and file URIs work without the project directory.
           (dolist (text (list "![](<mock ups/home 2.png>)"
                               (format nil "- ![](~a)" (uiop:native-namestring (merge-pathnames "mock.png" root)))
                               (format nil "![](~a)" (image-artifact-uri (merge-pathnames "mock.png" root)))))
             (let ((children (let ((*directory* (if (search "<" text) root nil))) (rendered text))))
               (assert (= 1 (length children)) () "~s rendered ~s" text children)
               (assert (typep (first children) 'gtk:button))))
           ;; Missing and remote images are described; unreadable ones still open.
           (let ((label (first (rendered "See ![Gone](missing.png) here"))))
             (assert (search "Gone (missing.png not found)" (gtk:label-get-text label))))
           ;; Links render as links, not as their Markdown source.
           (dolist (text '("![Logo](https://example.com/logo.png)" "[🖼 Logo](https://example.com)"))
             (assert (string= "🖼 Logo" (gtk:label-get-text (first (rendered text))))))
           (let ((children (rendered "![Bad](broken.png)")))
             (assert (and (= 1 (length children)) (typep (first children) 'gtk:button)))
             (assert (null (find-widgets (first children) 'gtk:picture)))
             (assert (search "no preview" (gtk:label-get-text (first (find-widgets (first children) 'gtk:label))))))
           ;; Code keeps image syntax as written.
           (assert (null (find-widgets (first (rendered (format nil "```~%![x](mock.png)~%```"))) 'gtk:picture))))
         ;; Streaming shows the raw text; the finished block shows the thumbnail.
         (let* ((*history* nil) (*panes* nil) (*controls* nil) (*workflow* nil)
                (*claude* (make-instance 'claude-agent :id :claude :name "Claude"))
                (*codex* (make-instance 'codex-agent :id :codex :name "ChatGPT"))
                (*middle* (multiple-value-bind (messages scroller) (make-message-list)
                            (make-pane :messages messages :scroller scroller))))
           (dolist (agent (list *claude* *codex*))
             (push (cons (agent-id agent) (make-agent-pane agent)) *panes*))
           (let ((claude (agent-pane-of *claude*)))
             (pane-delta claude "Mockup: ![Home](mo")
             (assert (null (find-widgets (pane-messages *middle*) 'gtk:button)))
             (pane-delta claude "ck.png)")
             (setf (agent-directory *claude*) root)
             (let ((*directory* (uiop:temporary-directory)))
               (pane-text claude "Mockup: ![Home](mock.png)"))
             (assert (= 1 (length (find-widgets (pane-messages *middle*) 'gtk:picture))))
             (clear-agent-pane claude)
             (clear-box (pane-messages *middle*))
             ;; A restored conversation resolves against its own folder.
             (setf (agent-directory *claude*) (uiop:temporary-directory))
             (let ((history (make-history root))
                   (*directory* (uiop:temporary-directory)))
               (history-add-entry history :claude :text "Saved ![Home](mock.png)")
               (history-add-entry history :middle :text (format nil "Claude → ChatGPT~%~%Saved ![Home](mock.png)"))
               (replay-history history)
               (assert (= 1 (length (find-widgets (pane-messages *middle*) 'gtk:picture)))))
             (clear-agent-pane claude)
             (clear-box (pane-messages *middle*)))
           ;; Protocol-generated image text uses the same live/history renderer.
           (let* ((pane (agent-pane-of *codex*))
                  (server (make-codex-app-server))
                  (saved nil))
             (setf (codex-agent-server *codex*) server
                   (agent-listener *codex*)
                   (lambda (agent kind &rest plist)
                     (declare (ignore agent))
                     (when (eq kind :text)
                       (setf saved (getf plist :text))
                       (pane-text pane saved))))
             (codex-agent-event *codex* server
               (make-codex-event :kind :image :text (namestring (merge-pathnames "mock.png" root))))
             (assert (= 1 (length (find-widgets (pane-messages *middle*) 'gtk:picture))))
             (clear-agent-pane pane)
             (clear-box (pane-messages *middle*))
             (let ((history (make-history root)))
               (history-add-entry history :codex :text saved)
               (replay-history history)
               (assert (= 1 (length (find-widgets (pane-messages *middle*) 'gtk:picture))))))))
    (uiop:delete-directory-tree root :validate t)))
(let ((*controls* nil) (*settings* nil) (*checklist* nil) (*checklist-findings* nil)
      (*checklist-boxes* nil))
  (make-checklist-panel)
  (let ((summary (make-checklist-summary))
        (toggle (make-instance 'gtk:check-button))
        (part (make-review-loop :author (make-instance 'claude-agent :id :claude :name "Claude")
                                :label "Claude's part" :task "Assigned work")))
    (setf (getf *controls* :checklist-toggle) toggle
          (getf *controls* :checklist-split) (make-instance 'gtk:paned)
          (getf *controls* :narrow-layout) t)
    (gobject:connect toggle :toggled
                     (lambda (widget)
                       (setf (setting :checklist-visible) (gtk:check-button-get-active widget))
                       (set-checklist-visible (gtk:check-button-get-active widget))
                       (refresh-checklist-summary)))
    (assert (not (gtk:widget-get-visible summary)))
    (show-checklist (checklist-text part) :notify nil)
    (assert (gtk:widget-get-visible summary))
    (let ((other (copy-review-loop part)))
      (setf (loop-label other) "ChatGPT's part" (loop-task other) "Other work")
      (show-checklist (checklist-text other) :notify nil))
    (setf (loop-state part) :unreviewed
          (loop-findings part) (list (make-finding :id 1 :text "Still open")
                                     (make-finding :id 2 :status :fixed :text "Resolved")
                                     (make-finding :id 3 :status :dismissed :text "Dismissed")))
    (show-checklist (checklist-text part) :notify nil)
    (assert (= 2 (length *checklist-boxes*)))
    (assert (= 2 (conversation-child-count (pane-messages *checklist*))))
    (assert (search "1 open finding" (gtk:label-get-text (gtk:button-get-child summary))))
    (let* ((entry (cdr (assoc "**Task checklist, Claude's part**" *checklist-boxes* :test #'string=)))
           (box (getf entry :box)))
      (assert (not (gtk:expander-get-expanded (getf entry :request))))
      (assert (not (gtk:expander-get-expanded (getf entry :resolved))))
      (assert (search "1 fixed · 1 dismissed" (gtk:expander-get-label (getf entry :resolved))))
      (assert (eq :attention (intern (string-upcase (getf (getf entry :data) :tone)) :keyword)))
      (gtk:expander-set-expanded (getf entry :request) t)
      (gtk:expander-set-expanded (getf entry :resolved) t)
      (setf (loop-state part) :approved)
      (show-checklist (checklist-text part) :notify nil)
      (let ((updated (cdr (assoc "**Task checklist, Claude's part**" *checklist-boxes* :test #'string=))))
        (assert (eq box (getf updated :box)))
        (assert (gtk:expander-get-expanded (getf updated :request)))
        (assert (gtk:expander-get-expanded (getf updated :resolved)))))
    (gobject:emit summary :clicked)
    (assert (gtk:check-button-get-active toggle))
    (assert (gtk:widget-get-visible (control :checklist-panel)))
    (assert (not (gtk:widget-get-visible summary)))
    (gtk:check-button-set-active toggle nil)
    (assert (gtk:widget-get-visible summary))
    (clear-checklist)
    (assert (null *checklist-boxes*))
    (assert (not (gtk:widget-get-visible summary))))
  ;; Legacy records remain readable inside a card.
  (show-checklist (format nil "**Review checklist**~%~%F1 old issue") :notify nil)
  (assert (= 1 (length *checklist-boxes*))))
(let* ((*history* nil) (*directory* nil) (*settings* nil) (*controls* nil)
       (*panes* nil) (*workflow* nil) (*view-only* nil) (*view* :sidebar)
       (*claude* (make-instance 'claude-agent :id :claude :name "Claude"))
       (*codex* (make-instance 'codex-agent :id :codex :name "ChatGPT")))
  (dolist (agent (list *claude* *codex*))
    (multiple-value-bind (pane widget) (make-agent-pane agent)
      (assert (some (lambda (expander)
                      (search "directly" (or (gtk:expander-get-label expander) "")))
                    (find-widgets widget 'gtk:expander)))
      (dolist (name '("MODEL-EXPANDED" "COMPOSER-EXPANDED"))
        (let* ((key (agent-setting-key agent name))
               (expander (control key)))
          (assert (= 12 (gtk:widget-get-margin-start expander)))
          (gtk:expander-set-expanded expander t)
          (assert (setting key))
          (let ((restored (make-agent-disclosure agent name "Restored" (make-instance 'gtk:label))))
            (assert (gtk:expander-get-expanded restored)))))
      (push (cons (agent-id agent) pane) *panes*)))
  ;; The application header normally provides these controls.
  (setf *controls* (list :folder (make-instance 'gtk:button)
                         :permission (make-instance 'gtk:button)))
  (make-middle-pane)
  (assert (search "Write & review" (gtk:label-get-text (control :workflow-summary))))
  (gtk:drop-down-set-selected (control :lead) 1)
  (assert (search "ChatGPT leads" (gtk:label-get-text (control :workflow-summary))))
  (gtk:spin-button-set-value (control :rounds) 5d0)
  (assert (search "5 rounds" (gtk:label-get-text (control :workflow-summary))))
  (gtk:drop-down-set-selected (control :mode) 3)
  (assert (search "Review only" (gtk:label-get-text (control :workflow-summary))))
  (assert (not (search "rounds" (gtk:label-get-text (control :workflow-summary)))))
  (gtk:drop-down-set-selected (control :mode) 0)
  (let ((original-send (symbol-function 'agent-send-now))
        (original-start (symbol-function 'start-request))
        (original-attention (symbol-function 'attention))
        (sent nil) (starts nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'agent-send-now)
                 (lambda (agent text &optional attachments)
                   (push (list agent text attachments) sent))
                 (symbol-function 'start-request)
                 (lambda (&optional attachments) (push attachments starts))
                 (symbol-function 'attention) (lambda (&rest args) (declare (ignore args))))
           ;; Idle both-agent messages retain the collaboration entry point.
           (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "Task" -1)
           (send-composer-message)
           (assert (= 1 (length starts)))
           (assert (null sent))
           ;; Individual routing works without creating a workflow, keeps the
           ;; other draft intact, and records a visible shared user message.
           (loop for index in '(1 2) for agent in (list *claude* *codex*) do
             (gtk:drop-down-set-selected (control :recipient) index)
             (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "Direction" -1)
             (set-attachments (control :composer-attachments) '("/tmp/example.txt"))
             (send-composer-message)
             (assert (eq agent (caar sent)))
             (assert (equal '("/tmp/example.txt") (third (car sent))))
             (assert (string= "" (text-view-text (control :input))))
             (assert (null (agent-pane-attachments (control :composer-attachments)))))
           ;; Both during a task steers only live task turns, never an idle reviewer.
           (setf *workflow* (make-instance 'workflow :lead *claude* :partner *codex* :request "Task")
                 (workflow-state *workflow*) :running
                 (agent-busy *claude*) t)
           (gtk:drop-down-set-selected (control :recipient) 0)
           (assert (search "only" (gtk:label-get-text (control :routing-note))))
           (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "Keep going" -1)
           (send-composer-message)
           (assert (= 3 (length sent)))
           (assert (= 2 (workflow-contract-revision *workflow*)))
           (assert (equal '("Keep going") (workflow-contract-directions *workflow*)))
           (assert (eq *claude* (caar sent)))
           (assert (= 1 (length starts)))
           ;; No live task turns: preserve the draft without submitting anything.
           (setf (agent-busy *claude*) nil)
           (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "Wait for a turn" -1)
           (send-composer-message)
           (assert (= 3 (length sent)))
           (assert (string= "Wait for a turn" (text-view-text (control :input))))
           ;; Second-recipient failure records the first delivery immediately;
           ;; retry sends only to the remaining recipient, retaining attachments.
           (setf (agent-busy *claude*) t (agent-busy *codex*) t)
           (let ((fail-second t)
                 (before (conversation-child-count (pane-messages *middle*))))
             (setf (symbol-function 'agent-send-now)
                   (lambda (agent text &optional attachments)
                     (when (and (eq agent *codex*) fail-second) (error "Still stopping"))
                     (push (list agent text attachments) sent)))
             (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "Deliver once" -1)
             (set-attachments (control :composer-attachments) '("/tmp/both.txt"))
             (send-composer-message)
             (assert (= 4 (length sent)))
             (assert (= 3 (workflow-contract-revision *workflow*)))
             (assert (= 2 (length (workflow-contract-directions *workflow*))))
             (assert (= (+ before 2) (conversation-child-count (pane-messages *middle*))))
             (assert (string= "Deliver once" (text-view-text (control :input))))
             (assert (equal '("/tmp/both.txt") (agent-pane-attachments (control :composer-attachments))))
             (setf fail-second nil)
             (send-composer-message)
             (assert (= 5 (length sent)))
             (assert (= 3 (workflow-contract-revision *workflow*)))
             (assert (= 2 (length (workflow-contract-directions *workflow*))))
             (assert (eq *codex* (caar sent)))
             (assert (equal '("/tmp/both.txt") (third (car sent))))
             (assert (null (control :composer-delivery)))
             (assert (string= "" (text-view-text (control :input))))
             (assert (null (agent-pane-attachments (control :composer-attachments)))))
           (assert (gtk:widget-get-sensitive (control :send)))
           ;; A successful individual direction stays out of the shared brief.
           (gtk:drop-down-set-selected (control :recipient) 1)
           (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "Only author" -1)
           (send-composer-message)
           (assert (= 3 (workflow-contract-revision *workflow*)))
           (assert (= 2 (length (workflow-contract-directions *workflow*))))
           ;; A failed send keeps the draft and files available for retry.
           (setf (symbol-function 'agent-send-now)
                 (lambda (&rest args) (declare (ignore args)) (error "Still stopping")))
           (gtk:drop-down-set-selected (control :recipient) 1)
           (gtk:text-buffer-set-text (gtk:text-view-get-buffer (control :input)) "Retry me" -1)
           (set-attachments (control :composer-attachments) '("/tmp/retry.txt"))
           (send-composer-message)
           (assert (= 3 (workflow-contract-revision *workflow*)))
           (assert (string= "Retry me" (text-view-text (control :input))))
           (assert (equal '("/tmp/retry.txt")
                          (agent-pane-attachments (control :composer-attachments)))))
      (setf (symbol-function 'agent-send-now) original-send
            (symbol-function 'start-request) original-start
            (symbol-function 'attention) original-attention))))

