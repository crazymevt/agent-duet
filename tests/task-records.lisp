(in-package #:agent-duet/tests)

(define-test task-record-parsers :parent agent-duet
  (is equal '((:id 1 :blocking t :text "Wait?") (:id 2 :blocking nil :text "Optional?")
              (:id 3 :blocking nil :text "Default?"))
      (ai::parse-questions-section
       (format nil "## QUESTIONS~%- Q1 [blocking] Wait?~%- Q2 [non-blocking] Optional?~%- Q3 Default?~%- Qx bad~%- Q4 [wrong] bad~%- Q5 [blocking]~%ANSWERS~%- Q1 Yes")))
  (false (ai::parse-questions-section "QUESTIONS: NONE"))
  (false (ai::parse-questions-section "ordinary text"))
  (is equal '((1 . "Yes")) (ai::parse-answers-section (format nil "ANSWERS~%- Q1 Yes~%- Qx bad~%- Q2")))
  (dolist (separator '(" — " " -- " " - "))
    (is equal '((:text "Use records" :reason "pure" :rejected ("global" "UI")))
        (ai::parse-decisions-section
         (format nil "DECISIONS~%- D1 Use records~abecause pure; rejected: global, UI~%- D2 malformed" separator)))))

(define-test task-record-operations :parent agent-duet
  (let* ((q (ai::make-task-question :id 2 :from :claude :to :codex :text "Proceed?" :blocking t))
         (questions (list q)))
    (is = 3 (ai::next-question-id questions))
    (is = 1 (length (ai::unanswered-questions questions :to :codex :blocking t)))
    (false (ai::unanswered-questions questions :blocking nil))
    (false (ai::answer-question questions 99 "No" 10))
    (is eq q (ai::answer-question questions 2 "Yes" 10))
    (is = 10 (ai::task-question-answered-at q))
    (false (ai::unanswered-questions questions))
    (true (search "Answer: Yes" (first (ai::questions-prompt-lines questions)))))
  (let* ((e (ai::make-evidence :kind :check :summary "Pass" :repo-state "abc"))
         (new (ai::make-evidence :kind :check :summary "Pass" :repo-state "abc" :source :codex)))
    (true (ai::evidence-current-p e "abc"))
    (false (ai::evidence-current-p e nil))
    (false (ai::evidence-current-p e "def"))
    (is equal (list new) (ai::record-evidence (list e) new))
    (true (search "stale" (first (ai::evidence-index-lines (list e) "def")))))
  (let ((d (ai::make-task-decision :id 1 :text "Records" :reason "Pure" :revision 1)))
    (ai::mark-decisions-stale (list d) 1)
    (false (ai::task-decision-stale d))
    (ai::mark-decisions-stale (list d) 2)
    (ai::mark-decisions-stale (list d) 3)
    (is = 2 (ai::task-decision-stale-at-revision d))
    (true (search "stale" (first (ai::decision-record-lines (list d)))))))

(define-test task-record-efficiency :parent agent-duet
  (let ((summary (ai::efficiency-summary
                  '((:kind :blocked-start :at 1 :step "a")
                    (:kind :blocked-start :at 2 :step "b")
                    (:kind :blocked-end :at 5 :step "a")
                    (:kind :check :at 6 :command "test" :repo-state "abc" :passed t)
                    (:kind :check :at 7 :command "test" :repo-state "abc" :passed nil)
                    (:kind :check :at 8 :command "test" :repo-state "def" :passed t)
                    (:kind :finding :at 8 :location " A:1 " :text "Fix  It" :round 1)
                    (:kind :finding :at 8 :location "a:1" :text "fix it" :round 1)
                    (:kind :finding :at 9 :location "a:1" :text "fix it" :round 2)
                    (:kind :rework :at 10 :part :merge)))))
    (is = 12 (getf summary :blocked-seconds))
    (is = 1 (getf summary :repeated-checks))
    (is = 1 (getf summary :recurring-findings))
    (is = 1 (getf summary :integration-reworks))
    (is = 4 (length (ai::efficiency-summary-lines summary))))
  (false (ai::efficiency-summary-lines (ai::efficiency-summary nil))))

(define-test task-record-persistence :parent agent-duet
  (dolist (input (list nil (ai:jobj) (ai::task-records-to-json nil nil nil nil)))
    (is equal '(nil nil nil nil) (multiple-value-list (ai::task-records-from-json input))))
  (let* ((q (ai::make-task-question :id 1 :from :claude :to "codex" :text "OK?" :blocking t :asked-at 1))
         (e (ai::make-evidence :id 1 :kind :check :summary "Pass" :source :check :repo-state "abc" :at 3))
         (d (ai::make-task-decision :id 1 :text "Use it" :reason "Simple" :rejected '("Other") :revision 1))
         (events '((:kind :check :at 2 :command "test" :repo-state nil :passed nil)
                   (:kind :rework :at 3 :part "merge"))))
    (ai::answer-question (list q) 1 "Yes" 2)
    (ai::mark-decisions-stale (list d) 2)
    (let* ((encoded (ai::task-records-to-json (list q) (list e) (list d) events))
           (wire (ai:parse-json (ai:json-string (ai::task-records-json-object encoded)))))
      (true (hash-table-p encoded))
      (multiple-value-bind (qs es ds restored) (ai::task-records-from-json wire)
        (is equalp (list q) qs)
        (is equalp (list e) es)
        (is equalp (list d) ds)
        (is equal events restored)))))
