;;;; Fake app-server: hold/fail/approval/steering controls are files in cwd.
(load (merge-pathnames "fake-cli.lisp" *load-truename*))
(in-package #:agent-duet)

(loop for message = (fake-read) while message do
  (let ((method (jget message "method")) (id (jget message "id"))
        (params (jget message "params")))
    (when method
      (fake-append "log" method)
      (fake-append "requests" (json-string (jobj "method" method "params" params))))
    (cond
      ((and (not method) (equal id "approval-1"))
       (fake-write "approval-decision" (jget message "result" "decision"))
       (fake-turn-finished))
      ((null id))
      ((equal method "initialize")
       (loop while (probe-file "hold") do (sleep 0.02))
       (fake-send (jobj "id" id "result" (jobj))))
      ((equal method "thread/start")
       (if (probe-file "fail-thread-once")
           (progn (delete-file "fail-thread-once")
                  (fake-send (jobj "id" id "error" (jobj "code" -32000 "message" "temporary failure"))))
           (fake-send (jobj "id" id "result" (jobj "thread" (jobj "id" "thread-1"))))))
      ((equal method "thread/resume")
       (if (probe-file "fail-resume")
           (fake-send (jobj "id" id "error" (jobj "code" -32600 "message" "no rollout found")))
           (fake-send (jobj "id" id "result" (jobj "thread" (jobj "id" (jget params "threadId")))))))
      ((equal method "turn/start")
       (fake-send (jobj "id" id "result" (jobj "turn" (jobj "id" "turn-1"))))
       (fake-send (jobj "method" "turn/started" "params" (jobj "turn" (jobj "id" "turn-1"))))
       (fake-disconnect)
       (cond ((probe-file "await-steer"))
             ((probe-file "request-approval")
              (fake-send (jobj "id" "approval-1" "method" "item/commandExecution/requestApproval"
                               "params" (jobj "command" "rm -rf build" "threadId" "thread-1" "turnId" "turn-1"))))
             (t (fake-turn-finished))))
      ((equal method "turn/steer")
       (assert (equal "turn-1" (jget params "expectedTurnId")))
       (assert (equal "thread-1" (jget params "threadId")))
       (fake-write "steered" (jget params "input" 0 "text"))
       (fake-send (jobj "id" id "result" (jobj "turnId" "turn-1")))
       (fake-turn-finished "steered reply" "m2"))
      (t (fake-send (jobj "id" id "result" (jobj)))))))
