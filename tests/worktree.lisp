(define-test recovery-unapproved-parts-finish-and-can-continue :parent agent-duet
  (with-worktree-repository (repo trees)
    (let ((ai::*default-max-rounds* 1)
          (approve nil))
      (multiple-value-bind (lead peer)
          (worktree-agents repo
                          (lambda (agent prompt)
                            (declare (ignore agent))
                            (cond ((search "Split the work" prompt) *split-plan*)
                                  ((search "Review the work" prompt)
                                   (if approve *approve* (format nil "Fix the edge case~%VERDICT: CHANGES REQUESTED")))
                                  (t "Lead result")))
                          (lambda (agent prompt)
                            (declare (ignore agent))
                            (if (search "Review the work" prompt)
                                (if approve *approve* (format nil "Fix the edge case~%VERDICT: CHANGES REQUESTED"))
                                "Partner result")))
        (let ((w (run-worktrees lead peer)))
          (setf trees (mapcar #'cdr (ai::workflow-trees w)))
          (is eq :finished (ai:workflow-state w))
          (false (ai::workflow-paused w))
          (false (ai::workflow-integrated w))
          (is eq :unresolved (getf (ai:workflow-completion w) :outcome))
          (is equal repo (ai:agent-directory lead))
          (is equal repo (ai:agent-directory peer))
          (true (ai:workflow-continuable-p w))
          (setf approve t)
          (true (ai:continue-workflow w 1))
          (is eq :finished (ai:workflow-state w))
          (true (ai::workflow-integrated w))
          (true (every (lambda (l) (eq (ai::loop-state l) :approved)) (ai:workflow-loops w))))))))

