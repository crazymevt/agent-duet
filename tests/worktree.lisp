(define-test recovery-snapshot-callback-cannot-overwrite-newer-pause :parent agent-duet
  (with-worktree-repository (repo trees)
    (let* ((lead (make-instance 'hanging-agent :id :claude :name "Claude" :directory repo :replies nil))
           (peer (make-instance 'hanging-agent :id :codex :name "ChatGPT" :directory repo :replies nil))
           (w (make-instance 'ai:workflow :lead lead :partner peer :request "Work")))
      ;; Delay delivery as GTK would, then apply the old callback last.
      (setf (ai::agent-deliver lead) (lambda (callback) (declare (ignore callback))))
      (ai:start-workflow w)
      (write-worktree-file repo "agent.txt" "First pause")
      (ai:pause-workflow-agent w lead)
      (let ((old (ai::workflow-recovery-capture w))
            (step (first (ai::workflow-paused w))))
        (ai::await-recovery-captures w)
        (write-worktree-file repo "agent.txt" "Newer pause")
        (incf (ai::step-generation step))
        (ai::pause-step w step)
        (ai::await-recovery-captures w)
        (let ((new (ai::workflow-recovery-capture w)))
          (ai::apply-recovery-capture w new)
          (ai::apply-recovery-capture w old)
          (is equalp (ai::recovery-capture-repositories new) (ai::workflow-recovery-baseline w))
          (is equalp (ai::recovery-capture-repositories new) (ai::step-repositories step)))))))


