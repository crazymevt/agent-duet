           (w (make-instance 'ai:workflow :lead lead :partner peer :request "Work"
                                         :on-finish (lambda (w) (declare (ignore w)) (incf finishes))))
           (l (ai::make-review-loop :author lead :reviewer peer :task "A" :tree tree :state :unresolved
                                   :last-review *approve* :check-failed t :summary "Work awaiting a passing check")))
      (push tree trees)
      (write-worktree-file tree "partial.txt" "Keep this")
      (setf (ai:workflow-state w) :running (ai::workflow-home w) repo
            (ai::workflow-trees w) (list (cons lead tree)) (ai:workflow-loops w) (list l))
      (ai::check-finished w)
      (is eq :finished (ai:workflow-state w))
