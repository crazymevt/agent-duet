(define-test recovery-running-history-refreshes-after-completed-work :parent agent-duet
  (with-history-directory
    (with-worktree-repository (repo trees)
      (let* ((lead (make-instance 'hanging-agent :id :claude :name "Claude" :directory repo :replies nil))
             (peer (make-instance 'hanging-agent :id :codex :name "ChatGPT" :directory repo :replies nil))
             (w (make-instance 'ai:workflow :lead lead :partner peer :request "Work")))
        (ai:start-workflow w)
        (write-worktree-file repo "agent.txt" "Finished implementation")
        (ai:agent-turn-finished lead "Implemented the task" nil)
        ;; Review is still running: simulate an app exit, with no Pause/Stop.
        (is eq :running (ai:workflow-state w))
        (true (ai:agent-busy peer))
        (false (ai::workflow-paused w))
        (ai::await-recovery-captures w)
        (let ((history (ai::make-history repo)))
          (ai::history-add-entry history :user :prompt "Work")
          (ai::record-history-checkpoint history (ai:workflow-checkpoint w))
          (ai::save-history history)
          (let* ((saved (ai::history-checkpoint (ai::load-history (ai::history-id history))))
                 (new-lead (make-instance 'hanging-agent :id :claude :name "Claude" :directory repo :replies nil))
                 (new-peer (make-instance 'hanging-agent :id :codex :name "ChatGPT" :directory repo :replies nil))
                 (restored (ai:restore-workflow saved :lead new-lead :partner new-peer)))
            (is eq :false (ai:jget (ai:inspect-workflow-recovery restored) "repository-changed"))
            (is eq :review (ai::step-role (first (ai::workflow-paused restored))))
            (is equal "Implemented the task" (ai::loop-summary (first (ai:workflow-loops restored))))
            (false (fake-prompts new-peer))
            (is eq :started (ai:recover-workflow restored :resume))
            (is = 1 (length (fake-prompts new-peer)))))))))

(define-test recovery-stop-preserves-existing-pause-snapshots :parent agent-duet
  (dolist (delayed-delivery '(nil t))
    (with-worktree-repository (repo trees)
      (let* ((lead (make-instance 'hanging-agent :id :claude :name "Claude" :directory repo :replies nil))
             (peer (make-instance 'hanging-agent :id :codex :name "ChatGPT" :directory repo :replies nil))
             (w (make-instance 'ai:workflow :lead lead :partner peer :request "Work")))
        (when delayed-delivery
          (setf (ai::agent-deliver lead) (lambda (callback) (declare (ignore callback)))))
        (ai:start-workflow w)
        (write-worktree-file repo "agent.txt" "Agent progress before Pause")
        (ai:pause-workflow-agent w lead)
        (ai:agent-turn-finished lead "Stopped" :interrupted)
        (ai:inspect-workflow-recovery w)
        (let* ((step (first (ai::workflow-paused w)))
               (capture (ai::step-repository-capture step))
               (baseline (ai::step-repositories step)))
          (write-worktree-file repo "user.txt" "User edits between Pause and Stop")
          (ai:stop-workflow w)
          (is eq :stopped (ai:workflow-state w))
          (is eq capture (ai::step-repository-capture step))
          (is eq baseline (ai::step-repositories step))
          (is eq t (ai:jget (ai:inspect-workflow-recovery w) "repository-changed"))
          (is eq :repository-changed (ai:recover-workflow w :resume :step step))
          (let ((restored (ai:restore-workflow (ai::json-copy (ai:workflow-checkpoint w))
                                             :lead lead :partner peer)))
            (is eq :repository-changed (ai:recover-workflow restored :resume))))))))
