;;;; worktree.lisp — isolated git integration

(in-package #:agent-duet/tests)

(defun write-worktree-file (directory name text)
  (with-open-file (out (merge-pathnames name directory) :direction :output
                       :if-exists :supersede :if-does-not-exist :create)
    (write-line text out)))

(defmacro with-worktree-repository ((repo trees) &body body)
  `(let ((,repo (merge-pathnames (format nil "duet-test-~a/" (ai::make-uuid))
                                 (uiop:temporary-directory)))
         (,trees nil))
     (ensure-directories-exist ,repo)
     (unwind-protect
          (progn
            (ai::worktree-git ,repo "init")
            (ai::worktree-git ,repo "config" "user.name" "Duet Test")
            (ai::worktree-git ,repo "config" "user.email" "duet@example.invalid")
            (ai::worktree-git ,repo "config" "commit.gpgsign" "false")
            (write-worktree-file ,repo "shared.txt" "base")
            (ai::commit-worktree ,repo "initial")
            ,@body)
       (dolist (tree ,trees)
         (ignore-errors (ai::worktree-git ,repo "worktree" "remove" "--force" (namestring tree)))
         (uiop:delete-directory-tree tree :validate t :if-does-not-exist :ignore))
       (uiop:delete-directory-tree ,repo :validate t :if-does-not-exist :ignore))))

(define-test git-inherits-environment-identity :parent agent-duet
  (let* ((names '("GIT_AUTHOR_NAME" "GIT_AUTHOR_EMAIL" "GIT_COMMITTER_NAME" "GIT_COMMITTER_EMAIL"))
         (values '("Environment Test" "environment@example.invalid" "Environment Test" "environment@example.invalid"))
         (saved (mapcar #'uiop:getenv names))
         (repo (merge-pathnames (format nil "duet-env-~a/" (ai::make-uuid)) (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (loop for name in names for value in values do (sb-posix:setenv name value 1))
           (ensure-directories-exist repo)
           (ai::worktree-git repo "init")
           (ai::worktree-git repo "config" "commit.gpgsign" "false")
           (true (search "environment@example.invalid" (ai::worktree-git-line repo "var" "GIT_AUTHOR_IDENT")))
           (write-worktree-file repo "file.txt" "content")
           (true (ai::commit-worktree repo "Environment identity"))
           (is string= "environment@example.invalid" (ai::worktree-git-line repo "log" "-1" "--format=%ae")))
      (loop for name in names for value in saved
            do (if value (sb-posix:setenv name value 1) (sb-posix:unsetenv name)))
      (uiop:delete-directory-tree repo :validate t :if-does-not-exist :ignore))))

(define-test worktree-clean-lifecycle
    :parent agent-duet
  (with-worktree-repository (repo trees)
    (true (ai::git-repository-p repo))
    (false (ai::git-repository-p (merge-pathnames "missing/" repo)))
    (let* ((tree (ai::create-worktree repo "clean"))
           (base (ai::worktree-git-line repo "rev-parse" "HEAD")))
      (push tree trees)
      (true (pathnamep tree))
      (is string= "agent-duet/clean" (ai::worktree-branch tree))
      (is string= "" (ai::worktree-diff tree))
      (false (ai::commit-worktree tree "no changes"))
      (write-worktree-file tree "new file.txt" "new content")
      (write-worktree-file tree "shared.txt" "changed")
      (let ((diff (ai::worktree-diff tree)))
        (true (search "new content" diff))
        (true (search "+changed" diff)))
      (true (ai::commit-worktree tree "changes"))
      (false (ai::commit-worktree tree "still unchanged"))
      (true (search "new content" (ai::worktree-diff tree)))
      (is string= base (ai::worktree-git-line tree "config" "branch.agent-duet/clean.agentDuetBase"))
      (is eq :merged (ai::merge-worktree repo tree))
      (true (probe-file (merge-pathnames "new file.txt" repo)))
      (true (ai::remove-worktree repo tree :delete-branch t))
      (false (probe-file tree))
      (is string= "" (ai::worktree-git repo "branch" "--list" "agent-duet/clean")))))

(define-test worktree-conflicting-merge
    :parent agent-duet
  (with-worktree-repository (repo trees)
    (let ((tree (ai::create-worktree repo "conflict")))
      (push tree trees)
      (write-worktree-file tree "shared.txt" "agent version")
      (ai::commit-worktree tree "agent change")
      (write-worktree-file repo "shared.txt" "main version")
      (ai::commit-worktree repo "main change")
      (multiple-value-bind (status files) (ai::merge-worktree repo tree)
        (is eq :conflict status)
        (is equal '("shared.txt") files))
      (true (search "<<<<<<<" (uiop:read-file-string (merge-pathnames "shared.txt" repo))))
      (ai::worktree-git repo "merge" "--abort")
      (true (ai::remove-worktree repo tree))
      (true (search "agent-duet/conflict" (ai::worktree-git repo "branch" "--list"))))))

(define-test worktree-recovery-refs
    :parent agent-duet
  (with-worktree-repository (repo trees)
    (let* ((base (ai::worktree-git-line repo "rev-parse" "HEAD"))
           (changed (ai::create-worktree repo "changed"))
           (unchanged (ai::create-worktree repo "unchanged"))
           (other (ai::create-worktree repo "other")))
      (setf trees (list changed unchanged other))
      (write-worktree-file changed "part.txt" "part work")
      (let ((commit (ai::commit-worktree changed "part")))
        ;; The default keeps no refs.
        (true (ai::remove-worktree repo other :delete-branch t))
        (is equal '() (ai::worktree-recovery-refs repo "task1"))
        (multiple-value-bind (head differs) (ai::retain-worktree repo changed "task1" "lead")
          (is string= commit head)
          (true differs))
        (true (ai::remove-worktree repo changed :delete-branch t))
        (true (ai::remove-worktree repo unchanged :delete-branch t :recovery-task "task1"))
        (false (probe-file changed))
        (false (probe-file unchanged))
        (is string= "" (ai::worktree-git repo "branch" "--list" "agent-duet/*"))
        (is equal (list (list :part "lead" :head commit :base base :changed t)
                        (list :part "unchanged" :head base :base base :changed nil))
            (ai::worktree-recovery-refs repo "task1"))
        ;; The work survives the worktree and branch, and the refs keep it from gc.
        (is string= (format nil "part work~%")
            (ai::worktree-git repo "show" "refs/agent-duet/tasks/task1/lead/head:part.txt"))
        (is equal '() (ai::worktree-recovery-refs repo "task"))
        (fail (ai::worktree-recovery-refs repo "a/b"))
        (fail (ai::delete-worktree-recovery-refs repo ""))
        (is = 2 (ai::delete-worktree-recovery-refs repo "task1" "unchanged"))
        (is equal '("lead") (mapcar (lambda (e) (getf e :part)) (ai::worktree-recovery-refs repo "task1")))
        (is = 2 (ai::delete-worktree-recovery-refs repo "task1"))
        (is = 0 (ai::delete-worktree-recovery-refs repo "task1"))
        (is string= "" (ai::worktree-git repo "for-each-ref" "refs/agent-duet/"))))))

(define-test worktree-recovery-retention-failure
    :parent agent-duet
  (with-worktree-repository (repo trees)
    (let ((tree (ai::create-worktree repo "kept")))
      (push tree trees)
      ;; An unusable part name: nothing is removed.
      (fail (ai::remove-worktree repo tree :delete-branch t :recovery-task "task" :recovery-part "bad name~"))
      (true (probe-file tree))
      (true (search "agent-duet/kept" (ai::worktree-git repo "branch" "--list")))
      (is equal '() (ai::worktree-recovery-refs repo "task"))
      ;; Retaining again replaces the earlier refs.
      (ai::retain-worktree repo tree "task")
      (write-worktree-file tree "later.txt" "later")
      (let ((commit (ai::commit-worktree tree "later")))
        (ai::retain-worktree repo tree "task")
        (is string= commit (getf (first (ai::worktree-recovery-refs repo "task")) :head))
        (is = 1 (length (ai::worktree-recovery-refs repo "task")))))))

(defun completed-test-workflow (repo &key dirty)
  (let* ((author (make-instance 'fake-agent :id :claude :name "Claude" :directory repo))
         (reviewer (make-instance 'fake-agent :id :codex :name "ChatGPT" :directory repo))
         (workflow (make-instance 'ai:workflow :lead author :partner reviewer :request "Test work")))
    (when dirty (write-worktree-file repo "existing.txt" "user edit"))
    (setf (ai::workflow-repository-start workflow) (ai::repository-start-state repo)
          (ai:workflow-state workflow) :running
          (ai:workflow-loops workflow)
          (list (ai::make-review-loop :author author :reviewer reviewer :state :approved
                                      :summary "Implemented the request")))
    workflow))

(define-test working-agent-suggests-commit-subject :parent agent-duet
  (multiple-value-bind (workflow messages author reviewer)
      (run-fake :review (list (says "Suggested commit: Color workflow stages"))
                        (list (says "VERDICT: APPROVED")))
    (declare (ignore messages reviewer))
    (is eq :finished (ai:workflow-state workflow))
    (true (search "Suggested commit:" (first (fake-prompts author))))
    (true (search "actual completed changes" (first (fake-prompts author))))
    (is string= "Color workflow stages" (ai::default-commit-message workflow))))

(define-test commit-suggestion-correction-prompts :parent agent-duet
  (let* ((author (make-instance 'fake-agent :id :claude :name "Claude" :directory (uiop:temporary-directory)))
         (reviewer (make-instance 'fake-agent :id :codex :name "ChatGPT" :directory (uiop:temporary-directory)))
         (loop (ai::make-review-loop :author author :reviewer reviewer :task "Implement colors"))
         (workflow (make-instance 'ai:workflow :lead author :partner reviewer :request "Implement colors"))
         (reply (ai::work-reply-instruction loop))
         (takeover (ai::takeover-prompt author reply)))
    (is string= takeover (ai::with-commit-suggestion-instruction takeover))
    (let* ((prompt (ai::fix-prompt loop "Changes requested"))
           (at (search "Suggested commit:" prompt)))
      (true at)
      (false (search "Suggested commit:" prompt :start2 (+ at 1))))
    ;; The paused merge's replacement author report needs a whole-task subject.
    (setf (ai:workflow-state workflow) :running)
    (ai::prerequisite-unmerged workflow loop "Finish merging the prerequisite" 0)
    (let ((prompt (ai::step-prompt (first (ai::workflow-paused workflow)))))
      (true (search "Suggested commit:" prompt))
      (true (search "whole task's completed changes" prompt)))
    (ai::await-recovery-captures workflow)
    (is string= "Implemented colors."
        (ai::report-without-commit-suggestion
         (format nil "Implemented colors.~%~%**Suggested commit:** Color workflow stages~%")))
    (is string= "Normal summary" (ai::report-without-commit-suggestion "Normal summary"))))

(define-test completed-work-commit-suggestion :parent agent-duet
  (let* ((workflow (make-instance 'ai:workflow :request "Please fix the thing I mentioned yesterday"))
         (part (ai::make-review-loop :summary "Added colors and removed inert buttons.")))
    (setf (ai:workflow-loops workflow) (list part))
    (is string= "Added colors and removed inert buttons." (ai::default-commit-message workflow))
    (setf (ai::loop-summary part)
          (format nil "Done.~%~%**Suggested commit:** Color workflow stages and remove inert buttons"))
    (is string= "Color workflow stages and remove inert buttons" (ai::default-commit-message workflow))
    ;; The combined report takes precedence over the two parts' suggestions.
    (setf (ai::workflow-merged-loop workflow)
          (ai::make-review-loop :summary "Suggested commit: Equalize agent panels and preserve custom splits"))
    (is string= "Equalize agent panels and preserve custom splits" (ai::default-commit-message workflow))
    (is = 72 (length (ai::commit-subject (make-string 100 :initial-element #\a))))
    (is string= "Fix layout" (ai::commit-subject (format nil "  `Fix layout`~%ignored body")))
    (is string= "Use the final combined changes"
        (ai::report-commit-suggestion
         (format nil "Suggested commit: Old partial suggestion~%Suggested commit: Use the final combined changes")))
    (setf (ai::workflow-merged-loop workflow) nil
          (ai::loop-summary part) "")
    (is string= "Update completed workflow changes" (ai::default-commit-message workflow))))

(define-test completion-user-commit :parent agent-duet
  (with-worktree-repository (repo trees)
    (let* ((workflow (completed-test-workflow repo))
           (head (ai::worktree-git-line repo "rev-parse" "HEAD")))
      (write-worktree-file repo "shared.txt" "completed edit")
      (write-worktree-file repo "new file.txt" "new file")
      (ai::finish-workflow workflow)
      (ai::await-completion-capture workflow)
      (let ((data (ai:workflow-completion workflow)))
        (is eq :approved (getf data :outcome))
        (is eq :approved (getf data :review-status))
        (is eq :not-run (getf data :check-status))
        (is string= "Implemented the request" (getf data :summary))
        (true (getf data :can-commit))
        ;; Reading completion must not stage or commit anything.
        (is string= head (ai::worktree-git-line repo "rev-parse" "HEAD"))
        (is string= "" (ai::worktree-git repo "diff" "--cached")))
      (let ((result (ai:commit-workflow-changes workflow :message "User requested commit")))
        (is eq :committed (getf result :status))
        (is string= (getf result :commit) (ai::worktree-git-line repo "rev-parse" "HEAD")))
      (is string= "" (ai::worktree-git repo "status" "--porcelain"))
      (false (getf (ai:workflow-completion workflow) :can-commit))
      (is eq :error (getf (ai:commit-workflow-changes workflow) :status)))))

(define-test completion-commit-refusals :parent agent-duet
  (dolist (scenario '(:later-edit :later-untracked :staged :branch :merge :busy :unapproved :failed-check))
    (with-worktree-repository (repo trees)
      (let* ((workflow (completed-test-workflow repo :dirty (eq scenario :dirty)))
             (head (ai::worktree-git-line repo "rev-parse" "HEAD")))
        (write-worktree-file repo "shared.txt" "completed edit")
        (write-worktree-file repo "new.txt" "completed untracked")
        (when (eq scenario :unapproved)
          (setf (ai::loop-state (first (ai:workflow-loops workflow))) :unresolved))
        (when (eq scenario :failed-check)
          (setf (ai::loop-check-failed (first (ai:workflow-loops workflow))) t))
        (ai::finish-workflow workflow)
      (ai::await-completion-capture workflow)
        (ecase scenario
          ((:unapproved :failed-check) nil)
          (:later-edit (write-worktree-file repo "shared.txt" "later edit"))
          (:later-untracked (write-worktree-file repo "new.txt" "later content"))
          (:staged (ai::worktree-git repo "add" "shared.txt"))
          (:branch (ai::worktree-git repo "checkout" "-b" "other"))
          (:merge (with-open-file (s (merge-pathnames ".git/MERGE_HEAD" repo) :direction :output)
                    (write-line head s)))
          (:busy (setf (ai:agent-busy (ai::workflow-lead workflow)) t)))
        (let ((status (ai::worktree-git repo "status" "--porcelain=v1")))
          (false (getf (ai:workflow-completion workflow) :can-commit))
          (is eq :error (getf (ai:commit-workflow-changes workflow) :status))
          (is string= head (ai::worktree-git-line repo "rev-parse" "HEAD"))
          (is string= status (ai::worktree-git repo "status" "--porcelain=v1")))))))

(define-test completion-clean-and-failed :parent agent-duet
  (with-worktree-repository (repo trees)
    (let ((workflow (completed-test-workflow repo)))
      (ai::finish-workflow workflow)
      (ai::await-completion-capture workflow)
      (false (getf (ai:workflow-completion workflow) :can-commit))
      (true (getf (ai:workflow-completion workflow) :clean))
      (is eq :clean (getf (ai:commit-workflow-changes workflow) :status))
      (ai::fail workflow "An explicit failure")
      (is eq :failed (getf (ai:workflow-completion workflow) :outcome))
      (is string= "An explicit failure" (getf (ai:workflow-completion workflow) :summary)))))

(define-test completion-commit-error-and-file-mode :parent agent-duet
  (with-worktree-repository (repo trees)
    (let* ((workflow (completed-test-workflow repo))
           (head (ai::worktree-git-line repo "rev-parse" "HEAD")))
      (write-worktree-file repo "new.txt" "completed edit")
      (ai::finish-workflow workflow)
      (ai::await-completion-capture workflow)
      (sb-posix:chmod (merge-pathnames "new.txt" repo) #o755)
      (false (getf (ai:workflow-completion workflow) :can-commit))
      (is eq :error (getf (ai:commit-workflow-changes workflow) :status))
      ;; Preserve an index containing only part of the completed edits.
      (write-worktree-file repo "shared.txt" "staged edit")
      (ai::worktree-git repo "add" "shared.txt")
      (ai::capture-workflow-completion workflow)
      (ai::await-completion-capture workflow)
      (write-worktree-file repo ".git/hooks/pre-commit" (format nil "#!/bin/sh~%exit 1"))
      (sb-posix:chmod (merge-pathnames ".git/hooks/pre-commit" repo) #o755)
      (let ((result (ai:commit-workflow-changes workflow)))
        (is eq :error (getf result :status))
        (true (search "Could not commit" (getf result :message))))
      (is string= head (ai::worktree-git-line repo "rev-parse" "HEAD"))
      (is equal (ai::workflow-completion-state workflow) (ai::repository-state repo))
      (true (getf (ai:workflow-completion workflow) :can-commit))
      (delete-file (merge-pathnames ".git/hooks/pre-commit" repo))
      (setf (ai::loop-summary (first (ai:workflow-loops workflow)))
            "Suggested commit: Preserve staging after failed commit hooks")
      (is eq :committed (getf (ai:commit-workflow-changes workflow) :status))
      (is string= "Preserve staging after failed commit hooks"
          (ai::worktree-git-line repo "log" "-1" "--format=%s")))))

(define-test completion-native-paths-and-batched-hashes :parent agent-duet
  (with-worktree-repository (repo trees)
    (let* ((workflow (completed-test-workflow repo))
           (names (append '("notes[1].md" "star*.txt" "what?.txt" "quote\"file" "back\\slash" "café.txt")
                          (list (format nil "two~%lines"))
                          (loop for i below 40 collect (format nil "generated-~d.txt" i)))))
      (dolist (name names)
        (with-open-file (out (merge-pathnames (uiop:parse-native-namestring name) repo)
                             :direction :output :if-exists :supersede)
          (write-string name out)))
      (let ((files (getf (ai::repository-state repo) :untracked)))
        (is = (length names) (length files))
        (dolist (name names)
          (let ((entry (assoc name files :test #'equal)))
            (true entry)
            (is string= (ai::worktree-git-line repo "hash-object" "--" name) (third entry)))))
      (ai::finish-workflow workflow)
      (ai::await-completion-capture workflow)
      (true (getf (ai:workflow-completion workflow) :can-commit))
      (false (getf (ai:workflow-completion workflow) :clean))
      (is eq :committed (getf (ai:commit-workflow-changes workflow) :status)))))

(define-test completion-detached-head-and-initial-untracked :parent agent-duet
  (with-worktree-repository (repo trees)
    (ai::worktree-git repo "checkout" "--detach")
    (let ((workflow (completed-test-workflow repo)))
      (write-worktree-file repo "shared.txt" "detached work")
      (ai::finish-workflow workflow)
      (ai::await-completion-capture workflow)
      (true (getf (ai:workflow-completion workflow) :repository))
      (true (getf (ai:workflow-completion workflow) :can-commit))
      (is eq :committed (getf (ai:commit-workflow-changes workflow) :status)))
    (let ((workflow (completed-test-workflow repo :dirty t)))
      (write-worktree-file repo "shared.txt" "later work")
      (ai::finish-workflow workflow)
      (ai::await-completion-capture workflow)
      (true (getf (ai:workflow-completion workflow) :can-commit))
      (let ((preview (ai::prepare-repository-commit repo :start (ai::workflow-repository-start workflow))))
        (is equal '("shared.txt") (getf preview :paths))
        (true (member "existing.txt" (getf preview :dirty) :test #'equal))))))

(define-test completion-error-cleared-on-continue :parent agent-duet
  (let* ((author (make-instance 'fake-agent :id :claude :name "Claude" :replies (list (says "Fixed"))))
         (reviewer (make-instance 'fake-agent :id :codex :name "ChatGPT" :replies (list (says *approve*))))
         (part (ai::make-review-loop :author author :reviewer reviewer :state :unresolved
                                     :task "Fix" :last-review "Please fix"))
         (workflow (make-instance 'ai:workflow :lead author :partner reviewer :request "Fix")))
    (setf (ai:workflow-state workflow) :finished
          (ai:workflow-loops workflow) (list part)
          (ai::workflow-context workflow) (ai::working-context workflow)
          (ai::workflow-completion-error workflow) "An old error")
    (true (ai:continue-workflow workflow 1))
    (false (ai::workflow-completion-error workflow))
    (is eq :approved (getf (ai:workflow-completion workflow) :outcome))))

(define-test completion-capture-off-caller-thread :parent agent-duet
  (with-worktree-repository (repo trees)
    (let* ((workflow (completed-test-workflow repo))
           (caller sb-thread:*current-thread*)
           (original (symbol-function 'ai::repository-state))
           (entered (sb-thread:make-semaphore))
           (release (sb-thread:make-semaphore))
           (capture-thread nil))
      (true (getf (ai::repository-start-state repo) :tree))
      (unwind-protect
           (progn
             (setf (symbol-function 'ai::repository-state)
                   (lambda (directory)
                     (setf capture-thread sb-thread:*current-thread*)
                     (sb-thread:signal-semaphore entered)
                     (sb-thread:wait-on-semaphore release)
                     (funcall original directory)))
             ;; Finish returns even though the full repository capture is blocked.
             (ai::finish-workflow workflow)
             (true (sb-thread:wait-on-semaphore entered :timeout 5))
             (false (eq caller capture-thread))
             (true (ai::workflow-completion-data workflow)))
        (sb-thread:signal-semaphore release)
        (ai::await-completion-capture workflow)
        (setf (symbol-function 'ai::repository-state) original))
      (true (getf (ai:workflow-completion workflow) :clean)))))

(define-test recovery-repository-inspection-is-read-only :parent agent-duet
  (with-worktree-repository (repo trees)
    (write-worktree-file repo "new.txt" "one")
    (let* ((before (ai:inspect-recovery-repository repo))
           (index (ai::worktree-git repo "diff" "--cached" "--binary")))
      (true (ai:jget before "available"))
      (write-worktree-file repo "new.txt" "two")
      (false (equalp before (ai:inspect-recovery-repository repo)))
      (is string= index (ai::worktree-git repo "diff" "--cached" "--binary"))
      (ai::commit-worktree repo "new commit")
      (false (equal (ai:jget before "head") (ai:jget (ai:inspect-recovery-repository repo) "head")))
      (let ((head (ai:jget (ai:inspect-recovery-repository repo) "head")))
        (ai::worktree-git repo "checkout" "-b" "changed-branch")
        (is string= head (ai:jget (ai:inspect-recovery-repository repo) "head"))
        (false (equal (ai:jget before "branch") (ai:jget (ai:inspect-recovery-repository repo) "branch")))))))

(define-test recovery-recreates-retained-worktree :parent agent-duet
  (with-worktree-repository (repo trees)
    (let ((tree (ai::create-worktree repo "missing-part")))
      (push tree trees)
      (write-worktree-file tree "saved.txt" "recover this")
      (ai::commit-worktree tree "part result")
      (ai::retain-worktree repo tree "restart-task")
      (ai::remove-worktree repo tree :delete-branch t)
      (let ((restored (ai::restore-recovery-worktree repo "restart-task" "missing-part")))
        (push restored trees)
        (true (probe-file (merge-pathnames "saved.txt" restored)))
        (is = 1 (length (ai::worktree-recovery-refs repo "restart-task")))
        (is string= "" (ai::worktree-git repo "status" "--porcelain"))))))

(define-test recovery-detects-repository-changes-before-resume :parent agent-duet
  (with-worktree-repository (repo trees)
    (let* ((lead (make-instance 'hanging-agent :id :claude :name "Claude" :directory repo :replies nil))
           (partner (make-instance 'fake-agent :id :codex :name "ChatGPT" :directory repo :replies nil))
           (workflow (make-instance 'ai:workflow :lead lead :partner partner :request "Work")))
      (ai:start-workflow workflow)
      (ai:pause-workflow-agent workflow lead)
      (ai:agent-turn-finished lead "Stopped" :interrupted)
      (ai:inspect-workflow-recovery workflow) ; the pause snapshot is ready
      (write-worktree-file repo "shared.txt" "user edit while paused")
      (is eq :repository-changed (ai:recover-workflow workflow :resume))
      (is = 1 (length (fake-prompts lead)))
