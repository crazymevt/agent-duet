#!/usr/bin/env python3
"""A stand-in for `codex app-server` in the tests: JSON-RPC over stdin/stdout.

Controlled by files in its working folder:
  hold              initialize waits while this exists
  fail-thread-once  thread/start fails once (the file is removed)
  fail-resume       thread/resume fails
Every method received is appended to the file `log`, one per line.
"""
import json, os, sys, time

def send(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()

for line in sys.stdin:
    try:
        msg = json.loads(line)
    except ValueError:
        continue
    method, rid = msg.get("method"), msg.get("id")
    if method:
        with open("log", "a") as log:
            log.write(method + "\n")
    if rid is None:
        continue
    if method == "initialize":
        while os.path.exists("hold"):
            time.sleep(0.02)
        send({"id": rid, "result": {}})
    elif method == "thread/start":
        if os.path.exists("fail-thread-once"):
            os.remove("fail-thread-once")
            send({"id": rid, "error": {"code": -32000, "message": "temporary failure"}})
        else:
            send({"id": rid, "result": {"thread": {"id": "thread-1"}}})
    elif method == "thread/resume":
        if os.path.exists("fail-resume"):
            send({"id": rid, "error": {"code": -32600, "message": "no rollout found"}})
        else:
            send({"id": rid, "result": {"thread": {"id": msg["params"]["threadId"]}}})
    elif method == "turn/start":
        send({"id": rid, "result": {"turn": {"id": "turn-1"}}})
        send({"method": "turn/started", "params": {"turn": {"id": "turn-1"}}})
        if os.path.exists("await-steer"):
            continue
        send({"method": "item/completed",
              "params": {"item": {"type": "agentMessage", "id": "m1", "text": "hi"}}})
        send({"method": "turn/completed", "params": {"turn": {"id": "turn-1", "status": "completed"}}})
    elif method == "turn/steer":
        params = msg["params"]
        assert params["expectedTurnId"] == "turn-1"
        assert params["threadId"] == "thread-1"
        with open("steered", "w") as out:
            out.write(params["input"][0]["text"])
        send({"id": rid, "result": {"turnId": "turn-1"}})
        send({"method": "item/completed", "params": {"item": {
            "type": "agentMessage", "id": "m2", "text": "steered reply"}}})
        send({"method": "turn/completed", "params": {"turn": {
            "id": "turn-1", "status": "completed"}}})
    elif method == "turn/interrupt":
        send({"id": rid, "result": {}})
    else:
        send({"id": rid, "result": {}})
