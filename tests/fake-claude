#!/usr/bin/env python3
"""A stand-in for `claude -p --input-format stream-json` in the tests.

With --resume, unless the session is one it made (listed in the file
`sessions`), it has no such session: it says so, as the CLI does, and
exits. Otherwise it answers each user message with "fresh reply". Its
arguments are appended to the file `args` in its working folder.

With the file `expect-steer` there, it reads two messages before answering
(either way), and the fresh reply lists their texts.

With the file `permission-request` there, holding {"tool_name": ..., "input": ...},
it asks permission for that tool before answering (a can_use_tool control
request) and appends the answer's response object to the file `permission-answers`.
"""
import json, os, sys, subprocess

args = sys.argv[1:]
with open("args", "a") as out:
    out.write(" ".join(args) + "\n")

def send(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()

def known_sessions():
    return open("sessions").read().split() if os.path.exists("sessions") else []

if "--resume" in args and args[args.index("--resume") + 1] not in known_sessions():
    session = args[args.index("--resume") + 1]
    sys.stdin.readline()
    if os.path.exists("expect-steer"):
        sys.stdin.readline()
    send({"type": "result", "subtype": "error_during_execution", "is_error": True,
          "session_id": session, "errors": ["No conversation found with session ID: " + session]})
    sys.exit(0)

if "--resume" in args:
    session = args[args.index("--resume") + 1]
else:
    session = args[args.index("--session-id") + 1] if "--session-id" in args else "new"
    with open("sessions", "a") as out:
        out.write(session + "\n")

def text(line):
    return json.loads(line)["message"]["content"][0]["text"]

def ask_permission():
    with open("permission-request") as f:
        request = json.load(f)
    # PreToolUse runs even when a saved/session allow rule would approve a tool.
    settings = json.loads(args[args.index("--settings") + 1]) if "--settings" in args else {}
    event = {"hook_event_name": "PreToolUse", "tool_name": request["tool_name"],
             "tool_input": request["input"]}
    for entry in settings.get("hooks", {}).get("PreToolUse", []):
        for hook in entry["hooks"]:
            result = subprocess.run(hook["command"], shell=True, input=json.dumps(event),
                                    text=True, capture_output=True, timeout=10)
            decision = json.loads(result.stdout).get("hookSpecificOutput", {}) if result.returncode == 0 else {"permissionDecision": "deny"}
            with open("hook-decisions", "a") as out:
                out.write(json.dumps(decision) + "\n")
            behavior = decision.get("permissionDecision")
            if behavior in ("allow", "deny"):
                if behavior == "allow" and "updatedInput" in decision:
                    request["input"] = decision["updatedInput"]
                return finish_permission(behavior, request)
    if os.path.exists("inherited-allow"):
        return finish_permission("allow", request)
    send({"type": "control_request", "request_id": "perm-1",
          "request": {"subtype": "can_use_tool", "tool_name": request["tool_name"],
                      "input": request["input"]}})
    for line in sys.stdin:
        msg = json.loads(line)
        if msg.get("type") == "control_response":
            with open("permission-answers", "a") as out:
                out.write(json.dumps(msg["response"]["response"]) + "\n")
            return msg["response"]["response"]["behavior"]

def finish_permission(behavior, request):
    with open("permission-answers", "a") as out:
        out.write(json.dumps({"behavior": behavior}) + "\n")
    if behavior == "allow" and request["tool_name"] == "Bash" and os.path.exists("execute-command"):
        result = subprocess.run(request["input"]["command"], shell=True, text=True,
                                capture_output=True, timeout=10)
        with open("command-output", "w") as out:
            out.write(result.stdout + result.stderr)
    return behavior

for line in sys.stdin:
    if json.loads(line).get("type") == "user":
        reply = "fresh reply"
        if os.path.exists("expect-steer"):
            reply += ": " + text(line) + " + " + text(sys.stdin.readline())
        send({"type": "system", "subtype": "init", "session_id": session})
        if os.path.exists("permission-request"):
            reply += " (" + str(ask_permission()) + ")"
        send({"type": "result", "subtype": "success", "is_error": False,
              "result": reply, "session_id": session})
