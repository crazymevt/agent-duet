;;;; Workspace navigation beside the conversation.
(in-package #:agent-duet)

(defun sidebar-files (directory)
  "Bounded project inventory. Skip hidden and generated dependency folders."
  (let ((root (truename directory)) (found nil) (count 0))
    (labels ((walk (dir depth)
               (when (< count 2000)
                 (dolist (file (uiop:directory-files dir))
                   (when (< count 2000)
                     (incf count)
                     (push (enough-namestring file root) found)))
                 (when (< depth 6)
                   (dolist (sub (uiop:subdirectories dir))
                     (let ((name (car (last (pathname-directory sub)))))
                       (unless (or (not (stringp name))
                                   (uiop:string-prefix-p "." name)
                                   (member name *skipped-folders* :test #'string=))
                         (walk sub (1+ depth)))))))))
      (walk root 0))
    (sort found #'string-lessp)))

(defun sidebar-artifact-p (file)
  (member (string-downcase (or (pathname-type file) ""))
          '("md" "markdown" "html" "htm" "pdf" "png" "jpg" "jpeg" "gif" "webp"
            "svg" "txt" "csv" "docx" "xlsx" "pptx") :test #'string=))

(defun make-sidebar-file-page (artifacts)
  (let* ((box (make-instance 'gtk:box :orientation :vertical :spacing 6))
         (search (make-instance 'gtk:search-entry :placeholder-text "Filter paths"))
         (refresh (make-instance 'gtk:button :label "Refresh"))
         (status (make-instance 'gtk:label :wrap t :xalign 0.0))
         (list (make-instance 'gtk:list-box :selection-mode :none))
         (generation 0) (files nil) (directory nil))
    (labels ((refill ()
               (gtk:list-box-remove-all list)
               (let* ((query (gtk:editable-get-text search))
                      (shown (remove-if-not (lambda (file) (search query file :test #'char-equal)) files)))
                 (dolist (file shown)
                   (let* ((path (merge-pathnames file directory))
                          (row (make-instance 'gtk:box :spacing 4))
                          (attach (make-instance 'gtk:button :label "+" :tooltip-text "Attach to your next message"))
                          (button (make-instance 'gtk:button :css-classes '("flat") :hexpand t
                                     :tooltip-text file
                                     :child (make-instance 'gtk:label :label file :xalign 0.0 :ellipsize :middle))))
                     (gobject:connect button :clicked
                       (lambda (button)
                         (if (markdown-file-p path)
                             (progn (show-documents) (show-document *docs* path))
                             (open-image-artifact path button))))
                     (gobject:connect attach :clicked
                       (lambda (button)
                         (declare (ignore button))
                         (let ((holder (control :composer-attachments)) (name (namestring path)))
                           (when holder
                             (set-attachments holder
                               (append (agent-pane-attachments holder)
                                       (unless (member name (agent-pane-attachments holder) :test #'equal)
                                         (list name))))))))
                     (gtk:box-append row button)
                     (gtk:box-append row attach)
                     (gtk:list-box-append list row)))
                 (gtk:label-set-text status
                   (if shown
                       (format nil "~d files · Open or attach with +~%Up to 2,000 files, 6 folders deep" (length shown))
                       "No matching files"))))
             (reload ()
               (let ((request (incf generation)) (root *directory*))
                 (setf directory root files nil)
                 (gtk:list-box-remove-all list)
                 (gtk:label-set-text status "Loading…")
                 (sb-thread:make-thread
                   (lambda ()
                     (handler-case
                         (let ((result (sidebar-files root)))
                           (deliver (lambda ()
                             (when (= request generation)
                               (setf files (if artifacts (remove-if-not #'sidebar-artifact-p result) result))
                               (refill)))))
                       (error (e)
                         (let ((message (format nil "Couldn't list files: ~a" e)))
                           (deliver (lambda ()
                             (when (= request generation) (gtk:label-set-text status message))))))))
                   :name "sidebar files"))))
      (gobject:connect search :search-changed (lambda (entry) (declare (ignore entry)) (refill)))
      (gobject:connect refresh :clicked (lambda (button) (declare (ignore button)) (reload)))
      (gtk:box-append box search)
      (gtk:box-append box refresh)
      (when artifacts
        (gtk:box-append box (make-instance 'gtk:label :wrap t :xalign 0.0
          :label "Documents, images and output files in this folder, including existing files.")))
      (gtk:box-append box status)
      (gtk:box-append box (make-instance 'gtk:scrolled-window :vexpand t :hscrollbar-policy :never :child list))
      (values box #'reload))))

(defun make-sidebar-changes-page ()
  (let ((box (make-instance 'gtk:box :orientation :vertical :spacing 6))
        (refresh (make-instance 'gtk:button :label "Refresh changes"))
        (current nil) (dispose nil))
    (labels ((reload ()
               (when dispose (funcall dispose) (setf dispose nil))
               (when current (gtk:box-remove box current))
               (setf current
                 (let ((task *task-changes*))
                   (if (and task (equal (task-changes-directory task) *directory*))
                       (multiple-value-bind (kind start end) (task-changes-range task)
                         (case kind
                           ((:final :live)
                            (let ((directory (task-changes-directory task)))
                              (multiple-value-bind (widget cleanup)
                                  (show-changes-window directory start
                                (if (eq kind :final) end
                                    (lambda () (task-snapshot task (format nil "sidebar-~a" (subseq (make-uuid) 0 8)))))
                                :embedded t
                                :on-close (when (eq kind :live)
                                  (lambda (snapshot)
                                    (when snapshot (ignore-errors (funcall *task-snapshot-delete* directory snapshot))))))
                                (setf dispose cleanup)
                                widget)))
                           (t (make-instance 'gtk:label :wrap t :label "Changes were not recorded for this task."))))
                       (make-instance 'gtk:label :wrap t :label "No task changes in this folder yet."))))
               (gtk:box-append box current)))
      (gtk:box-append box refresh)
      (gobject:connect refresh :clicked (lambda (button) (declare (ignore button)) (reload)))
      (values box #'reload))))

(defun refresh-workspace-sidebar ()
  (let ((reload (control :sidebar-refresh)))
    (when reload (funcall reload))))

(defun make-workspace-sidebar ()
  (let* ((tasks (make-checklist-panel))
         (book (make-instance 'gtk:notebook :scrollable t :width-request 260))
         (reloaders nil))
    (gtk:widget-set-visible tasks t)
    (gtk:notebook-append-page book tasks (make-instance 'gtk:label :label "Tasks"))
    (dolist (spec '(("Changes" . :changes) ("Files" . :files) ("Artifacts" . :artifacts)))
      (multiple-value-bind (page reload)
          (if (eq (cdr spec) :changes) (make-sidebar-changes-page)
              (make-sidebar-file-page (eq (cdr spec) :artifacts)))
        (push reload reloaders)
        (gtk:notebook-append-page book page (make-instance 'gtk:label :label (car spec)))))
    (setf reloaders (nreverse reloaders))
    (setf (getf *controls* :checklist-panel) book
          (getf *controls* :sidebar-refresh)
          (lambda ()
            (let ((index (gtk:notebook-get-current-page book)))
              (when (plusp index) (funcall (nth (1- index) reloaders))))))
    (gobject:connect book :switch-page
      (lambda (notebook page index)
        (declare (ignore notebook page))
        (when (plusp index) (funcall (nth (1- index) reloaders)))))
    (gtk:widget-set-visible book (setting :checklist-visible nil))
    book))
