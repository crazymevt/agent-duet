;;;; search.lisp — find rendered text without changing transcript contents.
(in-package #:agent-duet)

(defvar *pane-search-window* nil)
(defvar *pane-search-highlight* nil "Highlighted label and its original explicit attributes.")

(defun clear-pane-search-highlight ()
  (when *pane-search-highlight*
    (destructuring-bind (label attributes) *pane-search-highlight*
      (gtk:label-set-attributes label attributes))
    (setf *pane-search-highlight* nil)))

(defun highlight-pane-search-match (label start end)
  "Paint the exact match independently of keyboard focus; preserve label styling."
  (clear-pane-search-highlight)
  (let* ((original (gtk:label-get-attributes label))
         (saved (and original (pango:attr-list-copy original)))
         (attributes (if original (pango:attr-list-copy original) (pango:attr-list-new)))
         (text (gtk:label-get-text label))
         (byte-start (length (sb-ext:string-to-octets text :external-format :utf-8 :end start)))
         (byte-end (length (sb-ext:string-to-octets text :external-format :utf-8 :end end))))
    (dolist (attribute (list (pango:attr-background-new 65535 55255 16448)
                             (pango:attr-foreground-new 7710 6425 2570)))
      (setf (pango:attribute-start-index attribute) byte-start
            (pango:attribute-end-index attribute) byte-end)
      (pango:attr-list-insert attributes attribute))
    (setf *pane-search-highlight* (list label saved))
    (gtk:label-select-region label 0 0)
    (gtk:label-set-attributes label attributes)))

(defun pane-search-matches (pane query)
  "Return (label start end expanders) for each literal, case-insensitive match.
Walk rendered labels, including collapsed details, without searching composers."
  (when (plusp (length query))
    (labels ((walk (widget expanders)
               (cond
                 ((typep widget 'gtk:label)
                  (let ((text (gtk:label-get-text widget)))
                    (loop for start = (search query text :test #'char-equal)
                            then (search query text :start2 (+ start (length query)) :test #'char-equal)
                          while start collect (list widget start (+ start (length query)) expanders))))
                 ((typep widget 'gtk:expander)
                  ;; GTK unparents the content of collapsed expanders.
                  (let ((child (gtk:expander-get-child widget)))
                    (when child (walk child (cons widget expanders)))))
                 (t (loop for child = (gtk:widget-get-first-child widget)
                            then (gtk:widget-get-next-sibling child)
                          while child append (walk child expanders))))))
      (walk (pane-messages pane) nil))))

(defun reveal-pane-search-match (pane match)
  (destructuring-bind (label start end expanders) match
    (when (typep pane 'agent-pane)
      (let ((transcript (getf *controls* (agent-setting-key (agent-pane-agent pane) "TRANSCRIPT"))))
        (when transcript (gtk:expander-set-expanded transcript t))))
    (dolist (expander (reverse expanders)) (gtk:expander-set-expanded expander t))
    ;; Expand containing details and transcripts before asking layout for coordinates.
    (loop for parent = (gtk:widget-get-parent label) then (gtk:widget-get-parent parent)
          while parent
          when (typep parent 'gtk:expander) do (gtk:expander-set-expanded parent t))
    (gtk:label-set-selectable label t)
    (highlight-pane-search-match label start end)
    (glib:timeout-add glib:+priority-default+ 80
                   (lambda ()
                     (multiple-value-bind (ok x y)
                         (gtk:widget-translate-coordinates label (pane-messages pane) 0d0 0d0)
                       (declare (ignore x))
                       (when (and ok (eq (pane-scroller pane) *pane-search-scroller*))
                         (multiple-value-bind (offset-x offset-y) (gtk:label-get-layout-offsets label)
                           (declare (ignore offset-x))
                           (let* ((byte-index (length (sb-ext:string-to-octets
                                                       (gtk:label-get-text label)
                                                       :external-format :utf-8 :end start)))
                                  (position (pango:layout-index-to-pos (gtk:label-get-layout label) byte-index)))
                             (gtk:adjustment-set-value
                              (gtk:scrolled-window-get-vadjustment (pane-scroller pane))
                              (max 0d0 (+ y offset-y (/ (pango:rectangle-y position) 1024d0))))))))
                     nil))))

(defun focused-search-pane (panes)
  (let ((focus (and *window* (gtk:window-get-focus *window*))))
    (or (loop for widget = focus then (gtk:widget-get-parent widget)
              while widget
              thereis (find-if (lambda (pane)
                                 (or (eq widget (pane-messages pane))
                                     (eq widget (pane-scroller pane))
                                     (eq widget (pane-input pane))))
                               panes))
        *middle*)))

(defun show-pane-search ()
  "Find in the focused pane; default to the shared conversation."
  (when *pane-search-window*
    (gtk:window-present *pane-search-window*)
    (return-from show-pane-search *pane-search-window*))
  (let* ((choices (remove-if-not #'cdr
                                (append (list (cons "Conversation" *middle*))
                                        (mapcar (lambda (pair)
                                                  (cons (agent-name (agent-pane-agent (cdr pair))) (cdr pair)))
                                                *panes*)
                                        (list (cons "Checklist" *checklist*)
                                              (cons "Findings" *checklist-findings*)))))
         (panes (mapcar #'cdr choices))
         (names (mapcar #'car choices))
         (window (make-instance 'gtk:window :title "Find in pane" :transient-for *window*
                                :default-width 480))
         (box (make-instance 'gtk:box :orientation :vertical :spacing 8
                             :margin-start 12 :margin-end 12 :margin-top 12 :margin-bottom 12))
         (entry (make-instance 'gtk:entry :placeholder-text "Find text"))
         (selector (make-instance 'gtk:drop-down :model (gtk:string-list-new names)))
         (row (make-instance 'gtk:box :spacing 8))
         (count (make-instance 'gtk:label :label "Enter text to search" :hexpand t :xalign 0.0))
         (previous (make-instance 'gtk:button :label "Previous"))
         (next (make-instance 'gtk:button :label "Next"))
         (close (make-instance 'gtk:button :label "Close"))
         (matches nil) (index -1) (selected nil))
    (unless panes (return-from show-pane-search nil))
    (gtk:drop-down-set-selected selector (or (position (focused-search-pane panes) panes) 0))
    (labels ((resume-following ()
               (when *pane-search-scroller*
                 (let ((scroller *pane-search-scroller*))
                   (setf *pane-search-scroller* nil)
                   (scroll-adjustment-to-end (gtk:scrolled-window-get-vadjustment scroller)))))
             (pane () (nth (gtk:drop-down-get-selected selector) panes))
             (clear-selection ()
               (clear-pane-search-highlight)
               (when selected
                 (gtk:label-select-region (first selected) 0 0)
                 (setf selected nil)))
             (refresh ()
               (clear-selection)
               (resume-following)
               (setf matches (pane-search-matches (pane) (gtk:editable-get-text entry)) index -1)
               (gtk:label-set-text count (cond (matches (format nil "~d matches" (length matches)))
                                               ((zerop (length (gtk:editable-get-text entry))) "Enter text to search")
                                               (t "No matches")))
               (gtk:widget-set-sensitive next (not (null matches)))
               (gtk:widget-set-sensitive previous (not (null matches))))
             (move (step)
               ;; Recompute to account for streaming replies and conversation switches.
               (setf matches (pane-search-matches (pane) (gtk:editable-get-text entry)))
               (clear-selection)
               (if matches
                   (progn
                     (setf index (mod (if (minusp index) (if (minusp step) -1 0) (+ index step))
                                      (length matches))
                           selected (nth index matches))
                     (setf *pane-search-scroller* (pane-scroller (pane)))
                     (reveal-pane-search-match (pane) selected)
                     (gtk:label-set-text count (format nil "~d of ~d" (1+ index) (length matches))))
                   (refresh))))
      (gobject:connect entry :changed (lambda (e) (declare (ignore e)) (refresh)))
      (gobject:connect entry :activate (lambda (e) (declare (ignore e)) (move 1)))
      (gobject:connect selector "notify::selected" (lambda (w p) (declare (ignore w p)) (refresh)))
      (gobject:connect previous :clicked (lambda (b) (declare (ignore b)) (move -1)))
      (gobject:connect next :clicked (lambda (b) (declare (ignore b)) (move 1)))
      (gobject:connect close :clicked (lambda (b) (declare (ignore b)) (gtk:window-close window)))
      (gobject:connect window :close-request (lambda (w) (declare (ignore w)) (clear-selection) (resume-following)
                                                   (setf *pane-search-window* nil *pane-search-scroller* nil) nil))
      (let ((keys (gtk:event-controller-key-new)))
        (gobject:connect keys :key-pressed
                         (lambda (c key code state)
                           (declare (ignore c code))
                           (cond ((string= (gdk:keyval-name key) "Escape") (gtk:window-close window) t)
                                 ((and (string= (gdk:keyval-name key) "Return")
                                       (member :shift-mask (modifier-list state))) (move -1) t))))
        (gtk:event-controller-set-propagation-phase keys :capture)
        (gtk:widget-add-controller window keys))
      (refresh))
    (dolist (widget (list selector entry row)) (gtk:box-append box widget))
    (dolist (widget (list count previous next close)) (gtk:box-append row widget))
    (setf *pane-search-window* window)
    (gtk:window-set-destroy-with-parent window t)
    (gtk:window-set-child window box)
    (gtk:window-present window)
    (gtk:widget-grab-focus entry)
    window))
