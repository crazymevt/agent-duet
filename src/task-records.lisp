;;;; Pure task records, independent of workflow and presentation.
(in-package #:agent-duet)

(defstruct task-question id from to text blocking asked-at answer answered-at)
(defstruct evidence id kind summary repo-state source at)
(defstruct task-decision id text reason rejected revision stale stale-at-revision)

(defun tr-trim (text) (string-trim '(#\Space #\Tab #\Return #\Newline) text))

(defun tr-section (text name)
  "Read a named section, stopping at another heading or unbulleted label."
  (let ((active nil) (result nil))
    (dolist (raw (uiop:split-string (or text "") :separator '(#\Newline)))
      (let* ((line (tr-trim raw))
             (heading (tr-trim (string-left-trim "# " line)))
             (colon (position #\: heading))
             (label (string-right-trim ": " heading)))
        (cond ((or (string-equal label name)
                   (and colon (string-equal (subseq heading 0 colon) name)))
               (setf active t)
               (when (and colon (string-equal (tr-trim (subseq heading (1+ colon))) "NONE"))
                 (return-from tr-section nil)))
              ((and active (plusp (length line)))
               (if (or (char= (char line 0) #\#)
                       (member label '("QUESTIONS" "ANSWERS" "DECISIONS" "SUMMARY" "VERIFICATION" "FINDINGS") :test #'string-equal)
                       (and colon (not (char= (char line 0) #\-))))
                   (return)
                   (push line result))))))
    (nreverse result)))

(defun tr-numbered-line (line prefix)
  (let* ((s (tr-trim line)) (n (length s)))
    (when (and (> n 3) (char= (char s 0) #\-))
      (setf s (tr-trim (subseq s 1)) n (length s))
      (when (and (> n 1) (char-equal (char s 0) prefix))
        (let ((end (position-if-not #'digit-char-p s :start 1)))
          (when (and end (> end 1) (find (char s end) '(#\Space #\Tab)))
            (let ((body (tr-trim (subseq s end))))
              (unless (zerop (length body))
                (values (parse-integer s :start 1 :end end) body)))))))))

(defun parse-questions-section (text)
  (loop for line in (tr-section text "QUESTIONS")
        append (multiple-value-bind (id body) (tr-numbered-line line #\Q)
                 (when id
                   (let ((blocking nil) (valid t))
                     (when (char= (char body 0) #\[)
                       (let ((end (position #\] body)))
                         (if end
                             (let ((tag (subseq body 1 end)))
                               (setf blocking (string-equal tag "blocking")
                                     valid (or blocking (string-equal tag "non-blocking"))
                                     body (tr-trim (subseq body (1+ end)))))
                             (setf valid nil))))
                     (when (and valid (plusp (length body)))
                       (list (list :id id :blocking blocking :text body))))))))

(defun parse-answers-section (text)
  (loop for line in (tr-section text "ANSWERS")
        append (multiple-value-bind (id body) (tr-numbered-line line #\Q)
                 (when id (list (cons id body))))))

(defun next-question-id (questions)
  (1+ (reduce #'max questions :key #'task-question-id :initial-value 0)))
(defun answer-question (questions id text now)
  (let ((question (find id questions :key #'task-question-id :test #'equal)))
    (when question
      (setf (task-question-answer question) text (task-question-answered-at question) now)
      question)))
(defun unanswered-questions (questions &key to (blocking nil blocking-p))
  (remove-if-not (lambda (q) (and (null (task-question-answer q))
                                (or (null to) (equal to (task-question-to q)))
                                (or (not blocking-p)
                                    (eq (not (null blocking)) (not (null (task-question-blocking q)))))))
                 questions))
(defun questions-prompt-lines (questions)
  (mapcar (lambda (q) (format nil "- Q~a [~a] ~a~@[ Answer: ~a~]"
                             (task-question-id q)
                             (if (task-question-blocking q) "blocking" "non-blocking")
                             (task-question-text q) (task-question-answer q))) questions))

(defun evidence-current-p (evidence current-state)
  (and current-state (evidence-repo-state evidence)
       (equal current-state (evidence-repo-state evidence))))
(defun record-evidence (evidences evidence)
  (cons evidence (remove-if (lambda (old)
                             (and (eq (evidence-kind old) (evidence-kind evidence))
                                  (equal (evidence-summary old) (evidence-summary evidence))
                                  (equal (evidence-repo-state old) (evidence-repo-state evidence)))) evidences)))
(defun evidence-index-lines (evidences current-state)
  (mapcar (lambda (e) (format nil "- ~a [~(~a~)] [~a] ~a (source: ~a)"
                             (evidence-id e) (evidence-kind e)
                             (if (evidence-current-p e current-state) "current" "stale")
                             (evidence-summary e) (evidence-source e))) evidences))

(defun parse-decisions-section (text)
  (loop for line in (tr-section text "DECISIONS")
        append
        (multiple-value-bind (id body) (tr-numbered-line line #\D)
          (when id
            (let* ((separator (loop for sep in '(" — " " -- " " - ")
                                    for at = (search sep body)
                                    when at return (cons at (length sep))))
                   (reason (and separator (tr-trim (subseq body (+ (car separator) (cdr separator)))))))
              (when (and reason (<= 8 (length reason)) (string-equal "because " reason :end2 8))
                (setf reason (tr-trim (subseq reason 8)))
                (let* ((rejected-at (search "; rejected:" reason :test #'char-equal))
                       (rejected (when rejected-at
                                   (remove "" (mapcar #'tr-trim
                                                      (uiop:split-string (subseq reason (+ rejected-at 11))
                                                                         :separator '(#\,))) :test #'equal)))
                       (description (tr-trim (subseq body 0 (car separator))))
                       (why (tr-trim (if rejected-at (subseq reason 0 rejected-at) reason))))
                  (when (and (plusp (length description)) (plusp (length why)))
                    (list (list :text description :reason why :rejected rejected))))))))))
(defun mark-decisions-stale (decisions revision)
  (dolist (d decisions decisions)
    (when (and (not (task-decision-stale d)) (< (or (task-decision-revision d) 0) revision))
      (setf (task-decision-stale d) t (task-decision-stale-at-revision d) revision))))
(defun decision-record-lines (decisions)
  (mapcar (lambda (d) (format nil "- D~a ~a — because ~a~@[; rejected: ~{~a~^, ~}~]~a"
                             (task-decision-id d) (task-decision-text d) (task-decision-reason d)
                             (task-decision-rejected d) (if (task-decision-stale d) " [stale]" ""))) decisions))

(defun tr-normalize (text)
  (string-downcase (format nil "~{~a~^ ~}" (remove "" (uiop:split-string (or text "")
                               :separator '(#\Space #\Tab #\Newline #\Return)) :test #'equal))))
(defun efficiency-summary (events)
  (let ((starts (make-hash-table :test #'equal)) (checks (make-hash-table :test #'equal))
        (findings (make-hash-table :test #'equal)) (blocked 0) (repeated 0) (reworks 0)
        (latest (loop for e in events maximize (or (metric-number (getf e :at)) 0) into n finally (return (or n 0)))))
    ;; Stable sorting accepts either chronological or newest-first event storage.
    (dolist (e (stable-sort (copy-list events) #'< :key (lambda (e) (or (metric-number (getf e :at)) 0))))
      (let ((at (or (metric-number (getf e :at)) 0)) (step (getf e :step)))
        (case (getf e :kind)
          (:blocked-start (unless (gethash step starts) (setf (gethash step starts) at)))
          (:blocked-end (let ((start (gethash step starts)))
                          (when start (incf blocked (max 0 (- at start))) (remhash step starts))))
          (:check (let ((key (list (getf e :command) (getf e :repo-state))))
                    (when (gethash key checks) (incf repeated)) (setf (gethash key checks) t)))
          (:finding (pushnew (getf e :round)
                            (gethash (list (tr-normalize (getf e :location))
                                           (tr-normalize (getf e :text))) findings) :test #'equal))
          (:rework (incf reworks)))))
    (maphash (lambda (step start) (declare (ignore step)) (incf blocked (max 0 (- latest start)))) starts)
    (list :blocked-seconds blocked :repeated-checks repeated
          :recurring-findings (loop for rounds being the hash-values of findings count (> (length rounds) 1))
          :integration-reworks reworks)))
(defun efficiency-summary-lines (summary)
  (loop for (key label) in '((:blocked-seconds "Blocked seconds") (:repeated-checks "Repeated checks")
                             (:recurring-findings "Recurring findings") (:integration-reworks "Integration reworks"))
        for value = (getf summary key 0) when (plusp value) collect (format nil "~a: ~a" label value)))

;;; Preserve keyword/string distinctions while using ordinary lowercase JSON
;;; strings. The metadata also permits new event fields without a schema change.
(defun tr-plist-json (plist &optional boolean-keys list-keys)
  (apply #'jobj
         (append (loop for (key value) on plist by #'cddr
                       append (list (string-downcase key)
                                    (cond ((member key boolean-keys) (if value t :false))
                                          ((member key list-keys) (coerce value 'vector))
                                          ((keywordp value) (string-downcase value))
                                          (t value))))
                 (list "keyword-fields" (coerce (loop for (key value) on plist by #'cddr
                                                       when (and (keywordp value)
                                                                 (not (member key boolean-keys)))
                                                         collect (string-downcase key)) 'vector)))))
(defun tr-json-plist (object &optional boolean-keys list-keys)
  (let ((keywords (jlist (jget object "keyword-fields"))))
    (loop for (name . value) in (cdr object)
          unless (string= name "keyword-fields")
            append (let ((key (intern (string-upcase name) :keyword)))
                     (list key (cond ((member key boolean-keys) (jtrue-p value))
                                     ((member key list-keys) (jlist value))
                                     ((member name keywords :test #'equal) (intern (string-upcase value) :keyword))
                                     ((eq value :null) nil)
                                     (t value)))))))
(defun task-records-to-json (questions evidences decisions events)
  "Return a hash table. Use TASK-RECORDS-JSON-OBJECT for the project's writer."
  (let ((result (make-hash-table :test #'equal)))
    (setf (gethash "questions" result)
          (coerce (mapcar (lambda (q) (tr-plist-json
                          (list :id (task-question-id q) :from (task-question-from q) :to (task-question-to q)
                                :text (task-question-text q) :blocking (task-question-blocking q)
                                :asked-at (task-question-asked-at q) :answer (task-question-answer q)
                                :answered-at (task-question-answered-at q)) '(:blocking))) questions) 'vector)
          (gethash "evidence" result)
          (coerce (mapcar (lambda (e) (tr-plist-json
                          (list :id (evidence-id e) :kind (evidence-kind e) :summary (evidence-summary e)
                                :repo-state (evidence-repo-state e) :source (evidence-source e) :at (evidence-at e)))) evidences) 'vector)
          (gethash "decisions" result)
          (coerce (mapcar (lambda (d) (tr-plist-json
                          (list :id (task-decision-id d) :text (task-decision-text d) :reason (task-decision-reason d)
                                :rejected (task-decision-rejected d) :revision (task-decision-revision d)
                                :stale (task-decision-stale d) :stale-at-revision (task-decision-stale-at-revision d))
                          '(:stale) '(:rejected))) decisions) 'vector)
          (gethash "efficiency-events" result)
          (coerce (mapcar (lambda (e) (tr-plist-json e '(:passed))) events) 'vector))
    result))
(defun task-records-json-object (records)
  "Adapt the required hash table result to JSON.LISP's object representation."
  (apply #'jobj (loop for key in '("questions" "evidence" "decisions" "efficiency-events")
                     append (list key (gethash key records)))))
(defun task-records-from-json (object)
  (flet ((items (key) (jlist (if (hash-table-p object) (gethash key object) (jget object key)))))
    (values
     (mapcar (lambda (o)
               (let* ((p (tr-json-plist o '(:blocking)))
                      (q (apply #'make-task-question (loop for (k v) on p by #'cddr
                                                          unless (member k '(:answer :answered-at)) append (list k v)))))
                 (setf (task-question-answer q) (getf p :answer)
                       (task-question-answered-at q) (getf p :answered-at)) q)) (items "questions"))
     (mapcar (lambda (o) (apply #'make-evidence (tr-json-plist o))) (items "evidence"))
     (mapcar (lambda (o)
               (let* ((p (tr-json-plist o '(:stale) '(:rejected)))
                      (d (apply #'make-task-decision (loop for (k v) on p by #'cddr
                                                          unless (member k '(:stale :stale-at-revision)) append (list k v)))))
                 (setf (task-decision-stale d) (getf p :stale)
                       (task-decision-stale-at-revision d) (getf p :stale-at-revision)) d)) (items "decisions"))
     (mapcar (lambda (o) (tr-json-plist o '(:passed))) (items "efficiency-events")))))
